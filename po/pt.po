msgid "  -n NAME\tonly list requests and certs which use this nickname\n"
msgstr ""
"  -n NAME\tlistar apenas pedidos e certificados que utilizem esta alcunha\n"

#: src/getcert.c:2397
msgid "  -f FILE\tonly list requests and certs stored in this PEM file\n"
msgstr ""
"  -f FILE\tlistar apenas pedidos e certificados armazenados neste ficheiro "
"PEM\n"

#: src/getcert.c:2399 src/getcert.c:2414
