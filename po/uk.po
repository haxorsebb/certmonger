#, c-format
msgid "\ttrack: %s\n"
msgstr "\tстеження: %s\n"

#: src/getcert.c:1839
#, c-format
msgid "\tauto-renew: %s\n"
msgstr "\tавтооновлення: %s\n"

#: src/getcert.c:1881
#, c-format
msgid "CA '%s':\n"
msgstr "Служба сертифікації «%s»:\n"

#: src/getcert.c:1888
#, c-format
msgid "\tca-type: %s\n"
msgstr "\tca-тип: %s\n"

#: src/getcert.c:1890
#, c-format
msgid "\thelper-location: %s\n"
msgstr "\tадреса допоміжної програми: %s\n"

#: src/getcert.c:1894
#, c-format
