msgstr "* За ідентифікатором запиту:\n"

#: src/getcert.c:3423 src/getcert.c:3445 src/getcert.c:3496 src/getcert.c:3517
#: src/getcert.c:3537
msgid "  -i NAME\tnickname for tracking request\n"
msgstr "  -i НАЗВА\tПсевдонім запиту щодо стеження\n"

