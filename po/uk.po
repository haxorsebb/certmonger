#: src/getcert.c:3331 src/getcert.c:3379 src/getcert.c:3424 src/getcert.c:3446
#: src/getcert.c:3497 src/getcert.c:3518
msgid "* If using an NSS database for storage:\n"
msgstr "* Якщо для зберігання даних використовується база даних NSS:\n"

#: src/getcert.c:3332 src/getcert.c:3380 src/getcert.c:3425 src/getcert.c:3447
#: src/getcert.c:3519
msgid "  -d DIR\tNSS database for key and cert\n"
msgstr "  -d КАТАЛОГ\tБаза даних ключів і сертифікатів NSS\n"

#: src/getcert.c:3333 src/getcert.c:3381 src/getcert.c:3426 src/getcert.c:3448
#: src/getcert.c:3520
msgid "  -n NAME\tnickname for NSS-based storage (only valid with -d)\n"
msgstr "  -n НАЗВА\tпсевдонім сховища на основі NSS (працюватиме, лише якщо вказано -d)\n"

#: src/getcert.c:3334 src/getcert.c:3382 src/getcert.c:3427 src/getcert.c:3449
#: src/getcert.c:3521
msgid ""
"  -t NAME\toptional token name for NSS-based storage (only valid with -d)\n"
msgstr "  -t НАЗВА\tдодаткова назва ключа до заснованого на NSS сховища (працюватиме, лише якщо вказано -d)\n"

#: src/getcert.c:3335 src/getcert.c:3383 src/getcert.c:3428 src/getcert.c:3450
#: src/getcert.c:3500 src/getcert.c:3522
msgid "* If using files for storage:\n"
msgstr "* Якщо для зберігання даних використовуються файли:\n"

#: src/getcert.c:3336 src/getcert.c:3384 src/getcert.c:3429
msgid "  -k FILE\tPEM file for private key\n"
msgstr "  -k ФАЙЛ\tФайл PEM закритого ключа\n"

#: src/getcert.c:3337 src/getcert.c:3385 src/getcert.c:3430
msgid "  -f FILE\tPEM file for certificate (only valid with -k)\n"
msgstr "  -f ФАЙЛ\tФайл PEM сертифіката (працюватиме, лише якщо вказано -k)\n"

#: src/getcert.c:3338
msgid "* If keys are to be encrypted:\n"
msgstr "* Якщо ключі слід зашифрувати:\n"

#: src/getcert.c:3339 src/getcert.c:3387 src/getcert.c:3454
msgid "  -p FILE\tfile which holds the encryption PIN\n"
msgstr "  -p ФАЙЛ\tФайл, у якому зберігається PIN-код шифрування\n"

#: src/getcert.c:3340 src/getcert.c:3388 src/getcert.c:3455
msgid "  -P PIN\tPIN value\n"
msgstr "  -P PIN\tЗначення PIN-коду шифрування\n"

#: src/getcert.c:3342 src/getcert.c:3390 src/getcert.c:3432 src/getcert.c:3466
#: src/getcert.c:3488 src/getcert.c:3525 src/getcert.c:3535 src/getcert.c:3553
#: src/getcert.c:3568
msgid "Optional arguments:\n"
msgstr "Необов’язкові аргументи:\n"

#: src/getcert.c:3343 src/getcert.c:3391 src/getcert.c:3467
msgid "* Certificate handling settings:\n"
msgstr "* Параметри обробки сертифікатів:\n"

#: src/getcert.c:3344
msgid "  -I NAME\tnickname to assign to the request\n"
msgstr "  -I НАЗВА\tпсевдонім, який слід пов’язати з запитом\n"

#: src/getcert.c:3345
msgid "  -G TYPE\ttype of key to be generated if one is not already in place\n"
msgstr "  -G ТИП\tтип ключа, який слід створити, якщо не буде виявлено готового\n"

#: src/getcert.c:3346
msgid "  -g SIZE\tsize of key to be generated if one is not already in place\n"
msgstr "  -g РОЗМІР\tрозмір ключа, який слід створити, якщо не буде виявлено готового, у бітах\n"

#: src/getcert.c:3347 src/getcert.c:3393
msgid "  -r\t\tattempt to renew the certificate when expiration nears (default)\n"
msgstr "  -r\t\tСпробувати оновити сертифікат, якщо наближається завершення строку дії (типова поведінка)\n"

#: src/getcert.c:3348 src/getcert.c:3394
msgid "  -R\t\tdon't attempt to renew the certificate when expiration nears\n"
msgstr "  -R\t\tНе намагатися оновити сертифікат, якщо наближається завершення строку дії\n"

#: src/getcert.c:3350 src/getcert.c:3396
msgid "  -c CA\t\tuse the specified CA rather than the default\n"
msgstr "  -c CA\t\tвикористовувати вказану службу сертифікації (CA), а не типову\n"

#: src/getcert.c:3352 src/getcert.c:3398 src/getcert.c:3472
msgid ""
"  -T PROFILE\task the CA to process the request using the named profile or "
"template\n"
msgstr "  -T ПРОФІЛЬ\tпопросити CA обробити запит з використанням вказаного профілю або шаблона\n"

#: src/getcert.c:3353
msgid "* Parameters for the signing request:\n"
msgstr "* Параметри запиту щодо підписування:\n"

#: src/getcert.c:3354 src/getcert.c:3458
msgid "  -N NAME\tset requested subject name (default: CN=<hostname>)\n"
msgstr "  -N НАЗВА\tВстановити бажане призначення (Типово: CN=<назва вузла>)\n"

#: src/getcert.c:3355 src/getcert.c:3459
msgid "  -U EXTUSAGE\tset requested extended key usage OID\n"
msgstr "  -U ДОД.ВИКОР.\tВстановити додаткове використання ключа за допомогою OID\n"

#: src/getcert.c:3356 src/getcert.c:3401 src/getcert.c:3460
msgid "  -u KEYUSAGE\tset requested key usage value\n"
msgstr "  -u ВИКОРИСТАННЯ встановити вказане значення використання ключа\n"

#: src/getcert.c:3357 src/getcert.c:3461
msgid "  -K NAME\tset requested principal name\n"
msgstr "  -K НАЗВА\tВстановити вказану назву реєстраційного запису\n"

#: src/getcert.c:3358 src/getcert.c:3462
msgid "  -D DNSNAME\tset requested DNS name\n"
msgstr "  -D НАЗВА-DNS\tвстановити вказану назву за DNS\n"

#: src/getcert.c:3359 src/getcert.c:3463
msgid "  -E EMAIL\tset requested email address\n"
msgstr "  -E ЕЛ.ПОШТА\tвстановити вказану адресу електронної пошти\n"

#: src/getcert.c:3360 src/getcert.c:3464
msgid "  -A ADDRESS\tset requested IP address\n"
msgstr "  -A АДРЕСА\tвстановити вказану IP-адресу\n"

#: src/getcert.c:3361 src/getcert.c:3406 src/getcert.c:3433 src/getcert.c:3473
#: src/getcert.c:3502 src/getcert.c:3526 src/getcert.c:3543 src/getcert.c:3558
#: src/getcert.c:3574
msgid "* Bus options:\n"
msgstr "* Параметри каналу зв’язку:\n"

#: src/getcert.c:3362 src/getcert.c:3407 src/getcert.c:3434 src/getcert.c:3474
#: src/getcert.c:3527
msgid "  -S\t\tconnect to the certmonger service on the system bus\n"
msgstr "  -S\t\tВстановити зв’язок зі службою certmonger за допомогою системного каналу\n"

#: src/getcert.c:3363 src/getcert.c:3408 src/getcert.c:3435 src/getcert.c:3475
#: src/getcert.c:3528
msgid "  -s\t\tconnect to the certmonger service on the session bus\n"
msgstr "  -s\t\tВстановити зв’язок зі службою certmonger за допомогою каналу сеансу\n"

#: src/getcert.c:3364 src/getcert.c:3409 src/getcert.c:3436 src/getcert.c:3476
#: src/getcert.c:3505 src/getcert.c:3546 src/getcert.c:3561 src/getcert.c:3577
msgid "* Other options:\n"
msgstr "* Інші параметри:\n"

#: src/getcert.c:3365 src/getcert.c:3410 src/getcert.c:3477
msgid "  -B\tcommand to run before saving the certificate\n"
msgstr "  -B\tкоманда, яку слід виконати до збереження сертифіката\n"

#: src/getcert.c:3366 src/getcert.c:3411 src/getcert.c:3478
msgid "  -C\tcommand to run after saving the certificate\n"
msgstr "  -C\tкоманда, яку слід виконати після збереження сертифіката\n"

#: src/getcert.c:3367 src/getcert.c:3412 src/getcert.c:3479
msgid "  -F\tfile in which to store the CA's certificates\n"
msgstr "  -F\tфайл, у якому слід зберігати сертифікати CA\n"

#: src/getcert.c:3368 src/getcert.c:3413 src/getcert.c:3480
msgid "  -a\tNSS database in which to store the CA's certificates\n"
msgstr "  -a\tбаза даних NSS, у якій слід зберігати сертифікати CA\n"

#: src/getcert.c:3369 src/getcert.c:3414 src/getcert.c:3481
msgid "  -w\ttry to wait for the certificate to be issued\n"
msgstr "  -w\tспробувати зачекати на момент випуску сертифіката\n"

#: src/getcert.c:3370 src/getcert.c:3415 src/getcert.c:3437 src/getcert.c:3482
#: src/getcert.c:3506 src/getcert.c:3529 src/getcert.c:3547 src/getcert.c:3562
#: src/getcert.c:3578
msgid "  -v\treport all details of errors\n"
msgstr "  -v\tповідомляти про всі дані щодо помилок\n"

