msgid "  -S\tconnect to the certmonger service on the system bus\n"
msgstr "  -S\tВстановити зв’язок зі службою certmonger за допомогою системного каналу\n"

#: src/getcert.c:3504 src/getcert.c:3545 src/getcert.c:3560 src/getcert.c:3576
msgid "  -s\tconnect to the certmonger service on the session bus\n"
msgstr "  -s\tВстановити зв’язок зі службою certmonger за допомогою каналу сеансу\n"

