msgid "Required arguments:\n"
msgstr "Обов’язкові аргументи:\n"

#: src/getcert.c:2982 src/getcert.c:3029 src/getcert.c:3073 src/getcert.c:3095
#: src/getcert.c:3145
msgid "* If using an NSS database for storage:\n"
msgstr "* Якщо для зберігання даних використовується база даних NSS:\n"

#: src/getcert.c:2983 src/getcert.c:3030 src/getcert.c:3074 src/getcert.c:3096
msgid "  -d DIR\tNSS database for key and cert\n"
msgstr "  -d КАТАЛОГ\tБаза даних ключів і сертифікатів NSS\n"

#: src/getcert.c:2984 src/getcert.c:3031 src/getcert.c:3075 src/getcert.c:3097
msgid "  -n NAME\tnickname for NSS-based storage (only valid with -d)\n"
msgstr ""
"  -n НАЗВА\tпсевдонім сховища на основі NSS (працюватиме, лише якщо вказано -"
"d)\n"

#: src/getcert.c:2985 src/getcert.c:3032 src/getcert.c:3076 src/getcert.c:3098
msgid ""
"  -t NAME\toptional token name for NSS-based storage (only valid with -d)\n"
msgstr ""
"  -t НАЗВА\tдодаткова назва ключа до заснованого на NSS сховища "
"(працюватиме, лише якщо вказано -d)\n"

#: src/getcert.c:2986 src/getcert.c:3033 src/getcert.c:3077 src/getcert.c:3099
#: src/getcert.c:3148
msgid "* If using files for storage:\n"
msgstr "* Якщо для зберігання даних використовуються файли:\n"

#: src/getcert.c:2987 src/getcert.c:3034 src/getcert.c:3078
msgid "  -k FILE\tPEM file for private key\n"
msgstr "  -k ФАЙЛ\tФайл PEM закритого ключа\n"

#: src/getcert.c:2988 src/getcert.c:3035 src/getcert.c:3079
msgid "  -f FILE\tPEM file for certificate (only valid with -k)\n"
msgstr "  -f ФАЙЛ\tФайл PEM сертифіката (працюватиме, лише якщо вказано -k)\n"

#: src/getcert.c:2989
msgid "* If keys are to be encrypted:\n"
msgstr "* Якщо ключі слід зашифрувати:\n"

#: src/getcert.c:2990 src/getcert.c:3037 src/getcert.c:3103
msgid "  -p FILE\tfile which holds the encryption PIN\n"
msgstr "  -p ФАЙЛ\tФайл, у якому зберігається PIN-код шифрування\n"

#: src/getcert.c:2991 src/getcert.c:3038 src/getcert.c:3104
msgid "  -P PIN\tPIN value\n"
msgstr "  -P PIN\tЗначення PIN-коду шифрування\n"

#: src/getcert.c:2993 src/getcert.c:3040 src/getcert.c:3081 src/getcert.c:3115
#: src/getcert.c:3136 src/getcert.c:3160 src/getcert.c:3175
msgid "Optional arguments:\n"
msgstr "Необов’язкові аргументи:\n"

#: src/getcert.c:2994 src/getcert.c:3041 src/getcert.c:3116
msgid "* Certificate handling settings:\n"
msgstr "* Параметри обробки сертифікатів:\n"

#: src/getcert.c:2995
msgid "  -I NAME\tnickname to assign to the request\n"
msgstr "  -I НАЗВА\tпсевдонім, який слід пов’язати з запитом\n"

#: src/getcert.c:2996
msgid "  -G TYPE\ttype of key to be generated if one is not already in place\n"
msgstr ""
"  -G ТИП\tтип ключа, який слід створити, якщо не буде виявлено готового\n"

#: src/getcert.c:2997
msgid "  -g SIZE\tsize of key to be generated if one is not already in place\n"
msgstr ""
"  -g РОЗМІР\tрозмір ключа, який слід створити, якщо не буде виявлено "
"готового, у бітах\n"

#: src/getcert.c:2998 src/getcert.c:3043
msgid ""
"  -r\t\tattempt to renew the certificate when expiration nears (default)\n"
msgstr ""
"  -r\t\tСпробувати оновити сертифікат, якщо наближається завершення строку "
"дії (типова поведінка)\n"

#: src/getcert.c:2999 src/getcert.c:3044
msgid "  -R\t\tdon't attempt to renew the certificate when expiration nears\n"
msgstr ""
"  -R\t\tНе намагатися оновити сертифікат, якщо наближається завершення "
"строку дії\n"

#: src/getcert.c:3001 src/getcert.c:3046
msgid "  -c CA\t\tuse the specified CA rather than the default\n"
msgstr ""
"  -c CA\t\tвикористовувати вказану службу сертифікації (CA), а не типову\n"

#: src/getcert.c:3003 src/getcert.c:3048 src/getcert.c:3121
msgid ""
"  -T PROFILE\task the CA to process the request using the named profile or "
"template\n"
msgstr ""
"  -T ПРОФІЛЬ\tпопросити CA обробити запит з використанням вказаного профілю "
"або шаблона\n"

#: src/getcert.c:3004
msgid "* Parameters for the signing request:\n"
msgstr "* Параметри запиту щодо підписування:\n"

#: src/getcert.c:3005 src/getcert.c:3107
msgid "  -N NAME\tset requested subject name (default: CN=<hostname>)\n"
msgstr "  -N НАЗВА\tВстановити бажане призначення (Типово: CN=<назва вузла>)\n"

#: src/getcert.c:3006 src/getcert.c:3108
msgid "  -U EXTUSAGE\tset requested extended key usage OID\n"
msgstr ""
"  -U ДОД.ВИКОР.\tВстановити додаткове використання ключа за допомогою OID\n"

#: src/getcert.c:3007 src/getcert.c:3051 src/getcert.c:3109
msgid "  -u KEYUSAGE\tset requested key usage value\n"
msgstr "  -u ВИКОРИСТАННЯ встановити вказане значення використання ключа\n"

#: src/getcert.c:3008 src/getcert.c:3110
msgid "  -K NAME\tset requested principal name\n"
msgstr "  -K НАЗВА\tВстановити вказану назву реєстраційного запису\n"

#: src/getcert.c:3009 src/getcert.c:3111
msgid "  -D DNSNAME\tset requested DNS name\n"
msgstr "  -D НАЗВА-DNS\tвстановити вказану назву за DNS\n"

#: src/getcert.c:3010 src/getcert.c:3112
msgid "  -E EMAIL\tset requested email address\n"
msgstr "  -E ЕЛ.ПОШТА\tвстановити вказану адресу електронної пошти\n"

#: src/getcert.c:3011 src/getcert.c:3113
msgid "  -A ADDRESS\tset requested IP address\n"
msgstr "  -A АДРЕСА\tвстановити вказану IP-адресу\n"

#: src/getcert.c:3012 src/getcert.c:3056 src/getcert.c:3082 src/getcert.c:3122
#: src/getcert.c:3150 src/getcert.c:3165 src/getcert.c:3180
msgid "* Bus options:\n"
msgstr "* Параметри каналу зв’язку:\n"

#: src/getcert.c:3013 src/getcert.c:3057 src/getcert.c:3083 src/getcert.c:3123
msgid "  -S\t\tconnect to the certmonger service on the system bus\n"
msgstr ""
"  -S\t\tВстановити зв’язок зі службою certmonger за допомогою системного "
"каналу\n"

#: src/getcert.c:3014 src/getcert.c:3058 src/getcert.c:3084 src/getcert.c:3124
msgid "  -s\t\tconnect to the certmonger service on the session bus\n"
msgstr ""
"  -s\t\tВстановити зв’язок зі службою certmonger за допомогою каналу сеансу\n"

#: src/getcert.c:3015 src/getcert.c:3059 src/getcert.c:3085 src/getcert.c:3125
#: src/getcert.c:3153 src/getcert.c:3168 src/getcert.c:3183
msgid "* Other options:\n"
msgstr "* Інші параметри:\n"

#: src/getcert.c:3016 src/getcert.c:3060 src/getcert.c:3126
msgid "  -B\tcommand to run before saving the certificate\n"
msgstr "  -B\tкоманда, яку слід виконати до збереження сертифіката\n"

#: src/getcert.c:3017 src/getcert.c:3061 src/getcert.c:3127
msgid "  -C\tcommand to run after saving the certificate\n"
msgstr "  -C\tкоманда, яку слід виконати після збереження сертифіката\n"

#: src/getcert.c:3018 src/getcert.c:3062 src/getcert.c:3128
msgid "  -F\tfile in which to store the CA's certificates\n"
msgstr "  -F\tфайл, у якому слід зберігати сертифікати CA\n"

#: src/getcert.c:3019 src/getcert.c:3063 src/getcert.c:3129
msgid "  -a\tNSS database in which to store the CA's certificates\n"
msgstr "  -a\tбаза даних NSS, у якій слід зберігати сертифікати CA\n"

#: src/getcert.c:3020 src/getcert.c:3064 src/getcert.c:3086 src/getcert.c:3130
#: src/getcert.c:3154 src/getcert.c:3169 src/getcert.c:3184
msgid "  -v\treport all details of errors\n"
msgstr "  -v\tповідомляти про всі дані щодо помилок\n"

