#: src/certmaster.c:111 src/ipa.c:125
#, c-format
msgid "Unable to determine hostname of CA.\n"
msgstr "Не вдалося визначити назву вузла служби сертифікації (CA).\n"

#: src/certmaster.c:128 src/ipa.c:156
#, c-format
msgid "Unable to read signing request.\n"
msgstr "Не вдалося прочитати запит щодо підпису.\n"

#: src/certmaster.c:156 src/ipa.c:202
#, c-format
msgid "Error setting up for XMLRPC.\n"
msgstr "Помилка встановлення XMLRPC.\n"

#: src/certmaster.c:178 src/getcert.c:236 src/getcert.c:254 src/getcert.c:272
#: src/getcert.c:290 src/getcert.c:308 src/getcert.c:325 src/getcert.c:702
#: src/getcert.c:976 src/getcert.c:1178 src/getcert.c:1249 src/getcert.c:1505
#: src/getcert.c:1605 src/getcert.c:1671 src/getcert.c:1696 src/getcert.c:1711
#, c-format
msgid "Error parsing server response.\n"
msgstr "Помилка обробки відповіді сервера.\n"

#: src/certmaster.c:182
#, c-format
msgid "Server error.\n"
msgstr "Помилка сервера.\n"

#: src/getcert.c:88 src/getcert.c:117
#, c-format
msgid "Path \"%s\" is not absolute, using \"%s\" instead.\n"
msgstr "Шлях «%s» не є абсолютним, буде використано шлях «%s».\n"

#: src/getcert.c:92 src/getcert.c:121
#, c-format
msgid ""
"Path \"%s\" is not absolute, and there was an error determining the name of "
"the current directory.\n"
msgstr ""
"Шлях «%s» не є абсолютним, спроба визначення назви поточного каталогу також "
"зазнала невдачі.\n"

#: src/getcert.c:140 src/getcert.c:166
#, c-format
msgid "Error connecting to DBus.\n"
msgstr "Помилка під час спроби встановлення з’єднання з DBus.\n"

#: src/getcert.c:173
#, c-format
msgid "Error creating DBus request message.\n"
msgstr "Помилка під час спроби створення повідомлення запиту до DBus.\n"

#: src/getcert.c:192
#, c-format
msgid "Error %s: %s\n"
msgstr "Помилка %s: %s\n"

#: src/getcert.c:195
#, c-format
msgid "Error %s\n"
msgstr "Помилка %s\n"

#: src/getcert.c:199
#, c-format
msgid "Error: %s\n"
msgstr "Помилка: %s\n"

#: src/getcert.c:201
#, c-format
msgid "Received error response from local %s service.\n"
msgstr "Отримано повідомлення про помилку від локальної служби %s.\n"

#: src/getcert.c:207
#, c-format
msgid "No response received from %s service.\n"
msgstr "Не отримано відповіді від служби %s.\n"

#: src/getcert.c:364 src/getcert.c:1300
#, c-format
msgid "Error initializing Kerberos library: %s.\n"
msgstr "Помилка під час ініціалізації бібліотеки Kerberos: %s.\n"

#: src/getcert.c:421 src/getcert.c:1343
#, c-format
msgid "Could not evaluate OID \"%s\".\n"
msgstr "Не вдалося визначити OID «%s».\n"

#: src/getcert.c:431 src/getcert.c:1353
#, c-format
msgid "Error parsing Kerberos principal name \"%s\": %s.\n"
msgstr "Помилка під час обробки реєстраційного запису Kerberos «%s»: %s.\n"

#: src/getcert.c:439 src/getcert.c:1361
#, c-format
msgid "Error unparsing Kerberos principal name \"%s\": %s.\n"
msgstr "Помилка під час пакування реєстраційного запису Kerberos «%s»: %s.\n"

#: src/getcert.c:472 src/getcert.c:1081 src/getcert.c:1199 src/getcert.c:1402
#, c-format
msgid "Database location or nickname specified without the other.\n"
msgstr ""
"Вказано адресу бази даних або псевдонім без визначення іншого необхідного "
"елемента.\n"

#: src/getcert.c:478 src/getcert.c:1087 src/getcert.c:1205 src/getcert.c:1408
#, c-format
msgid "Database directory and certificate file both specified.\n"
msgstr "Одночасно вказано каталог бази даних і файл сертифіката.\n"

#: src/getcert.c:486 src/getcert.c:1213 src/getcert.c:1416
#, c-format
msgid "None of database directory and nickname or certificate file specified.\n"
msgstr "Не вказано ні каталогу бази даних з псевдонімом, ні файла сертифіката.\n"

#: src/getcert.c:493 src/getcert.c:1103
#, c-format
msgid "Key and certificate can not both be saved to the same file.\n"
msgstr "Ключ і сертифікат не можна зберігати у одному файлі.\n"

#: src/getcert.c:518
#, c-format
msgid ""
"The IPA backend requires the use of the -K option (principal name) when the -"
"N option (subject name) is used.\n"
msgstr ""
"Сервер IPA потребує використання параметра -K (назви реєстраційного запису), "
"якщо використано параметр -N (призначення).\n"

#: src/getcert.c:648 src/getcert.c:955 src/getcert.c:1155 src/getcert.c:1436
#, c-format
msgid "No CA with name \"%s\" found.\n"
msgstr "Не виявлено служби сертифікації (CA) з назвою «%s».\n"

#: src/getcert.c:697 src/getcert.c:971 src/getcert.c:1172 src/getcert.c:1244
#: src/getcert.c:1499
#, c-format
msgid "Error setting request arguments.\n"
msgstr "Помилка під час спроби встановлення параметрів запиту.\n"

#: src/getcert.c:708
#, c-format
msgid "New signing request \"%s\" added.\n"
msgstr "Додано новий запит «%s» щодо підписування.\n"

#: src/getcert.c:711
#, c-format
msgid "New signing request could not be added.\n"
msgstr "Не вдалося додати новий запит щодо підписування.\n"

#: src/getcert.c:982
#, c-format
msgid "New tracking request \"%s\" added.\n"
msgstr "Додано новий запит «%s» щодо стеження.\n"

#: src/getcert.c:986
#, c-format
msgid "New tracking request could not be added.\n"
msgstr "Не вдалося додати новий запит щодо стеження.\n"

#: src/getcert.c:1096
#, c-format
msgid ""
"None of ID or database directory and nickname or certificate file "
"specified.\n"
msgstr ""
"Не вказано ні ідентифікатора, ні каталогу бази даних з псевдонімом, ні файла "
"сертифіката.\n"

#: src/getcert.c:1186
#, c-format
msgid "Request \"%s\" modified.\n"
msgstr "Змінено запит «%s».\n"

#: src/getcert.c:1190
#, c-format
msgid "Request \"%s\" could not be modified.\n"
msgstr "Не вдалося змінити запит «%s».\n"

#: src/getcert.c:1236 src/getcert.c:1422
#, c-format
msgid "No request found that matched arguments.\n"
msgstr "Запиту, що відповідає аргументам, не виявлено.\n"

#: src/getcert.c:1254
#, c-format
msgid "Request \"%s\" removed.\n"
msgstr "Запит «%s» вилучено.\n"

#: src/getcert.c:1258
#, c-format
msgid "Request \"%s\" could not be removed.\n"
msgstr "Не вдалося вилучити запит «%s».\n"

#: src/getcert.c:1513
#, c-format
msgid "Error modifying \"%s\".\n"
msgstr "Помилка під час спроби змінити «%s».\n"

#: src/getcert.c:1529
#, c-format
msgid "Resubmitting \"%s\" to \"%s\".\n"
msgstr "Повторне надсилання «%s» до «%s».\n"

#: src/getcert.c:1532
#, c-format
msgid "Resubmitting \"%s\".\n"
msgstr "Повторне надсилання «%s».\n"

#: src/getcert.c:1538
#, c-format
msgid "Error attempting to submit \"%s\" to \"%s\".\n"
msgstr "Помилка під час спроби надсилання «%s» до «%s».\n"

#: src/getcert.c:1541
#, c-format
msgid "Error attempting to submit \"%s\".\n"
msgstr "Помилка під час спроби надсилання «%s».\n"

#: src/getcert.c:1658
#, c-format
msgid "Request ID '%s':\n"
msgstr "Ідентифікатор запиту «%s»:\n"

#: src/getcert.c:1659
#, c-format
msgid "\tstatus: %s\n"
msgstr "\tстан: %s\n"

#: src/getcert.c:1663
#, c-format
msgid "\tca-error: %s\n"
msgstr "\tca-помилка: %s\n"

#: src/getcert.c:1665
#, c-format
msgid "\tstuck: %s\n"
msgstr "\tприв’язка: %s\n"

#: src/getcert.c:1685
#, c-format
msgid "\tkey pair storage: %s%s%s%s%s%s%s%s%s%s%s%s%s%s\n"
msgstr "\tсховище пар ключів: %s%s%s%s%s%s%s%s%s%s%s%s%s%s\n"

#: src/getcert.c:1686
msgid "type="
msgstr "тип="

#: src/getcert.c:1687
msgid ",location='"
msgstr ",адреса='"

#: src/getcert.c:1688 src/getcert.c:1702
msgid ",nickname="
msgstr ",псевдонім="

#: src/getcert.c:1689 src/getcert.c:1703
msgid ",token='"
msgstr ",ключ='"

#: src/getcert.c:1690
msgid ",pin="
msgstr ",pin="

#: src/getcert.c:1691
msgid ",pinfile="
msgstr ",файл pin="

#: src/getcert.c:1700
#, c-format
msgid "\tcertificate: type=%s,location='%s'%s%s%s%s%s\n"
msgstr "\tсертифікат: тип=%s,адреса='%s'%s%s%s%s%s\n"

#: src/getcert.c:1716
#, c-format
msgid "\tCA: %s\n"
msgstr "\tCA: %s\n"

#: src/getcert.c:1718
#, c-format
msgid "\tissuer: %s\n"
msgstr "\tвидавець: %s\n"

#: src/getcert.c:1719
#, c-format
msgid "\tsubject: %s\n"
msgstr "\tпризначення: %s\n"

#: src/getcert.c:1720
#, c-format
msgid "\texpires: %s\n"
msgstr "\tзавершення дії: %s\n"

#: src/getcert.c:1721
msgid "unknown"
msgstr "невідоме"

#: src/getcert.c:1724
msgid "\temail: "
msgstr "\tел. пошта: "

#: src/getcert.c:1730
msgid "\tdns: "
msgstr "\tdns: "

#: src/getcert.c:1736
msgid "\tprincipal name: "
msgstr "\tреєстраційний запис: "

#: src/getcert.c:1742
msgid "\teku: "
msgstr "\teku: "

#: src/getcert.c:1746
#, c-format
msgid "\ttrack: %s\n"
msgstr "\tстеження: %s\n"

#: src/getcert.c:1750
#, c-format
msgid "\tauto-renew: %s\n"
msgstr "\tавтооновлення: %s\n"

#: src/getcert.c:1792
#, c-format
msgid "CA '%s':\n"
msgstr "Служба сертифікації «%s»:\n"

#: src/getcert.c:1799
#, c-format
msgid "\tca-type: %s\n"
msgstr "\tca-тип: %s\n"

#: src/getcert.c:1801
#, c-format
msgid "\thelper-location: %s\n"
msgstr "\tадреса допоміжної програми: %s\n"

#: src/getcert.c:1805
#, c-format
msgid "\tnext-serial-number: %s\n"
msgstr "\tнаступний серійний номер: %s\n"

#: src/getcert.c:1813
#, c-format
msgid "\tknown-issuer-names:\n"
msgstr "\tвідомі назви видавця:\n"

#: src/getcert.c:1839
#, c-format
msgid "%s - client certificate enrollment tool\n"
msgstr "%s — інструмент реєстрації клієнтських сертифікатів\n"

#: src/getcert.c:1843
#, c-format
msgid "Usage: %s request [options]\n"
msgstr "Використання: %s request [параметри]\n"

#: src/getcert.c:1845 src/getcert.c:1880 src/getcert.c:1911 src/getcert.c:1931
msgid "Required arguments:\n"
msgstr "Обов’язкові аргументи:\n"

#: src/getcert.c:1846 src/getcert.c:1883 src/getcert.c:1914 src/getcert.c:1934
msgid "* If using an NSS database for storage:\n"
msgstr "* Якщо для зберігання даних використовується база даних NSS:\n"

#: src/getcert.c:1847 src/getcert.c:1884 src/getcert.c:1915 src/getcert.c:1935
msgid "  -d DIR\tNSS database for key and cert\n"
msgstr "  -d КАТАЛОГ\tБаза даних ключів і сертифікатів NSS\n"

#: src/getcert.c:1848 src/getcert.c:1885 src/getcert.c:1916 src/getcert.c:1936
msgid "  -n NAME\tnickname for NSS-based storage (only valid with -d)\n"
msgstr ""
"  -n НАЗВА\tпсевдонім сховища на основі NSS (працюватиме, лише якщо вказано -"
"d)\n"

#: src/getcert.c:1849 src/getcert.c:1886 src/getcert.c:1917 src/getcert.c:1937
msgid ""
"  -t NAME\toptional token name for NSS-based storage (only valid with -d)\n"
msgstr ""
"  -t НАЗВА\tдодаткова назва ключа до заснованого на NSS сховища "
"(працюватиме, лише якщо вказано -d)\n"

#: src/getcert.c:1850 src/getcert.c:1887 src/getcert.c:1918 src/getcert.c:1938
msgid "* If using files for storage:\n"
msgstr "* Якщо для зберігання даних використовуються файли:\n"

#: src/getcert.c:1851 src/getcert.c:1888 src/getcert.c:1919
msgid "  -k FILE\tPEM file for private key\n"
msgstr "  -k ФАЙЛ\tФайл PEM закритого ключа\n"

#: src/getcert.c:1852 src/getcert.c:1889 src/getcert.c:1920
msgid "  -f FILE\tPEM file for certificate (only valid with -k)\n"
msgstr "  -f ФАЙЛ\tФайл PEM сертифіката (працюватиме, лише якщо вказано -k)\n"

#: src/getcert.c:1853
msgid "* If keys are to be encrypted:\n"
msgstr "* Якщо ключі слід зашифрувати:\n"

#: src/getcert.c:1854 src/getcert.c:1892 src/getcert.c:1942
msgid "  -p FILE\tfile which holds the encryption PIN\n"
msgstr "  -p ФАЙЛ\tФайл, у якому зберігається PIN-код шифрування\n"

#: src/getcert.c:1855 src/getcert.c:1893 src/getcert.c:1943
msgid "  -P PIN\tPIN value\n"
msgstr "  -P PIN\tЗначення PIN-коду шифрування\n"

#: src/getcert.c:1857 src/getcert.c:1895 src/getcert.c:1922 src/getcert.c:1952
#: src/getcert.c:1966 src/getcert.c:1981
msgid "Optional arguments:\n"
msgstr "Необов’язкові аргументи:\n"

#: src/getcert.c:1858 src/getcert.c:1896 src/getcert.c:1953
msgid "* Certificate handling settings:\n"
msgstr "* Параметри обробки сертифікатів:\n"

#: src/getcert.c:1859
msgid "  -I NAME\tnickname to assign to the request\n"
msgstr "  -I НАЗВА\tпсевдонім, який слід пов’язати з запитом\n"

#: src/getcert.c:1860
msgid "  -g SIZE\tsize of key to be generated if one is not already in place\n"
msgstr ""
"  -g РОЗМІР\tрозмір ключа, який слід створити, якщо не буде виявлено "
"готового, у бітах\n"

#: src/getcert.c:1861 src/getcert.c:1898
msgid ""
"  -r\t\tattempt to renew the certificate when expiration nears (default)\n"
msgstr ""
"  -r\t\tСпробувати оновити сертифікат, якщо наближається завершення строку "
"дії (типова поведінка)\n"

#: src/getcert.c:1862 src/getcert.c:1899
msgid "  -R\t\tdon't attempt to renew the certificate when expiration nears\n"
msgstr ""
"  -R\t\tНе намагатися оновити сертифікат, якщо наближається завершення "
"строку дії\n"

#: src/getcert.c:1864 src/getcert.c:1901
msgid "  -c CA\t\tuse the specified CA rather than the default\n"
msgstr ""
"  -c CA\t\tвикористовувати вказану службу сертифікації (CA), а не типову\n"

#: src/getcert.c:1866
msgid "* Parameters for the signing request:\n"
msgstr "* Параметри запиту щодо підписування:\n"

#: src/getcert.c:1867 src/getcert.c:1946
msgid "  -N NAME\tset requested subject name (default: CN=<hostname>)\n"
msgstr "  -N НАЗВА\tВстановити бажане призначення (Типово: CN=<назва вузла>)\n"

#: src/getcert.c:1868 src/getcert.c:1947
msgid "  -U EXTUSAGE\tset requested extended key usage OID\n"
msgstr ""
"  -U ДОД.ВИКОР.\tВстановити додаткове використання ключа за допомогою OID\n"

#: src/getcert.c:1869 src/getcert.c:1948
msgid "  -K NAME\tset requested principal name\n"
msgstr "  -K НАЗВА\tВстановити вказану назву реєстраційного запису\n"

#: src/getcert.c:1870 src/getcert.c:1949
msgid "  -D DNSNAME\tset requested DNS name\n"
msgstr "  -D НАЗВА-DNS\tвстановити вказану назву за DNS\n"

#: src/getcert.c:1871 src/getcert.c:1950
msgid "  -E EMAIL\tset requested email address\n"
msgstr "  -E ЕЛ.ПОШТА\tвстановити вказану адресу електронної пошти\n"

#: src/getcert.c:1872 src/getcert.c:1903 src/getcert.c:1923 src/getcert.c:1958
#: src/getcert.c:1973 src/getcert.c:1986
msgid "* Bus options:\n"
msgstr "* Параметри каналу зв’язку:\n"

#: src/getcert.c:1873 src/getcert.c:1904 src/getcert.c:1924 src/getcert.c:1959
msgid "  -S\t\tconnect to the certmonger service on the system bus\n"
msgstr ""
"  -S\t\tВстановити зв’язок зі службою certmonger за допомогою системного "
"каналу\n"

#: src/getcert.c:1874 src/getcert.c:1905 src/getcert.c:1925 src/getcert.c:1960
msgid "  -s\t\tconnect to the certmonger service on the session bus\n"
msgstr ""
"  -s\t\tВстановити зв’язок зі службою certmonger за допомогою каналу сеансу\n"

#: src/getcert.c:1878
#, c-format
msgid "Usage: %s start-tracking [options]\n"
msgstr "Використання: %s start-tracking [параметри]\n"

#: src/getcert.c:1881
msgid "* If modifying an existing request:\n"
msgstr "* У разі зміни існуючого запиту:\n"

#: src/getcert.c:1882
msgid "  -i NAME\tnickname of an existing tracking request\n"
msgstr "  -i НАЗВА\tПсевдонім існуючого запиту щодо стеження\n"

#: src/getcert.c:1891 src/getcert.c:1941
msgid "* If keys are encrypted:\n"
msgstr "* Якщо ключі зашифровано:\n"

#: src/getcert.c:1897
msgid "  -I NAME\tnickname to give to tracking request\n"
msgstr "  -I НАЗВА\tПсевдонім, який слід пов’язати з запитом щодо стеження\n"

#: src/getcert.c:1909
#, c-format
msgid "Usage: %s stop-tracking [options]\n"
msgstr "Використання: %s stop-tracking [параметри]\n"

#: src/getcert.c:1912 src/getcert.c:1932
msgid "* By request identifier:\n"
msgstr "* За ідентифікатором запиту:\n"

#: src/getcert.c:1913 src/getcert.c:1933
msgid "  -i NAME\tnickname for tracking request\n"
msgstr "  -i НАЗВА\tПсевдонім запиту щодо стеження\n"

#: src/getcert.c:1929
#, c-format
msgid "Usage: %s resubmit [options]\n"
msgstr "Використання: %s resubmit [параметри]\n"

#: src/getcert.c:1939
msgid "  -f FILE\tPEM file for certificate\n"
msgstr "  -f ФАЙЛ\tФайл PEM сертифіката\n"

#: src/getcert.c:1945
msgid "* New parameter values for the signing request:\n"
msgstr "* Нові значення параметрів запиту щодо підписування:\n"

#: src/getcert.c:1954
msgid "  -I NAME\tnew nickname to give to tracking request\n"
msgstr ""
"  -I НАЗВА\tНовий псевдонім, який слід пов’язати з запитом щодо стеження\n"

#: src/getcert.c:1956
msgid "  -c CA\t\tuse the specified CA rather than the current one\n"
msgstr ""
"  -c CA\t\tВикористовувати вказану службу сертифікації (CA), а не поточну\n"

#: src/getcert.c:1964
#, c-format
msgid "Usage: %s list [options]\n"
msgstr "Використання: %s list [параметри]\n"

#: src/getcert.c:1967 src/getcert.c:1983
msgid "* General options:\n"
msgstr "* Загальні параметри:\n"

#: src/getcert.c:1969
msgid "  -c CA\tlist only requests and certs associated with this CA\n"
msgstr ""
"  -c CA\tПоказати список лише тих запитів та сертифікатів, які пов’язано з "
"вказаною службою сертифікації (CA)\n"

#: src/getcert.c:1971
msgid "  -r\tlist only information about outstanding requests\n"
msgstr "  -r\tПоказати лише відомості щодо нетипових запитів\n"

#: src/getcert.c:1972
msgid "  -t\tlist only information about tracked certificates\n"
msgstr ""
"  -t\tПоказати лише відомості щодо сертифікатів, за якими ведеться стеження\n"

#: src/getcert.c:1974 src/getcert.c:1987
msgid "  -S\tconnect to the certmonger service on the system bus\n"
msgstr ""
"  -S\tВстановити зв’язок зі службою certmonger за допомогою системного "
"каналу\n"

#: src/getcert.c:1975 src/getcert.c:1988
msgid "  -s\tconnect to the certmonger service on the session bus\n"
msgstr ""
"  -s\tВстановити зв’язок зі службою certmonger за допомогою каналу сеансу\n"

#: src/getcert.c:1979
#, c-format
msgid "Usage: %s list-cas [options]\n"
msgstr "Використання: %s list-cas [параметри]\n"

#: src/getcert.c:1984
msgid "  -c CA\tlist only information about the CA with this name\n"
msgstr ""
"  -c CA\tПоказати лише відомості щодо служби сертифікації (CA) з вказаною "
"назвою\n"

#: src/getcert.c:2039
#, c-format
msgid "%s: unrecognized command\n"
msgstr "%s: невідома команда\n"

#: src/ipa.c:122
#, c-format
msgid "Unable to determine location of CA's XMLRPC server.\n"
msgstr "Не вдалося визначити адресу сервера XMLRPC служби сертифікації (CA).\n"

#: src/ipa.c:130
#, c-format
msgid "Unable to determine principal name for signing request.\n"
msgstr ""
"Не вдалося визначити назву реєстраційного запису запиту щодо підписування.\n"

#: src/ipa.c:211
#, c-format
msgid ""
"Error setting up ccache for local \"host\" service using default keytab.\n"
msgstr ""
"Помилка налаштування ccache для локальної служби «host» за допомогою типової "
"таблиці ключів.\n"

#: src/ipa.c:215
#, c-format
msgid "Error setting up ccache for \"%s\" using default keytab.\n"
msgstr ""
"Помилка налаштування ccache для «%s» за допомогою типової таблиці ключів.\n"

#: src/ipa.c:221
#, c-format
msgid "Error setting up ccache for local \"host\" service using keytab \"%s\".\n"
msgstr ""
"Помилка налаштування ccache для локальної служби «host» за допомогою таблиці "
"ключів «%s».\n"

#: src/ipa.c:225
#, c-format
msgid "Error setting up ccache for \"%s\" using keytab \"%s\".\n"
msgstr "Помилка налаштування ccache для «%s» за допомогою таблиці ключів «%s».\n"

#: src/tdbush.c:193 src/tdbush.c:1055 src/tdbush.c:1219
msgid "An internal error has occurred."
msgstr "Сталася внутрішня помилка."

#: src/tdbush.c:257
msgid "No matching entry found.\n"
msgstr "Відповідного запису не знайдено.\n"

#: src/tdbush.c:402
msgid "Certificate storage type not specified."
msgstr "Тип сховища сертифікатів не вказано."

#: src/tdbush.c:416
#, c-format
msgid "Certificate storage type \"%s\" not supported."
msgstr "Підтримки типу сховищ сертифікатів «%s» не передбачено."

#: src/tdbush.c:439 src/tdbush.c:463 src/tdbush.c:504 src/tdbush.c:650
#: src/tdbush.c:692 src/tdbush.c:1950
#, c-format
msgid "The location \"%s\" must be an absolute path."
msgstr "Адресою «%s» має бути абсолютний шлях."

#: src/tdbush.c:455 src/tdbush.c:496
msgid "Certificate storage location not specified."
msgstr "Адресу сховища сертифікатів не вказано."

#: src/tdbush.c:472 src/tdbush.c:659
#, c-format
msgid "The parent of location \"%s\" must be a valid directory."
msgstr "Батьківським каталогом адреси «%s» має бути коректний каталог."

#: src/tdbush.c:481 src/tdbush.c:668
#, c-format
msgid "The location \"%s\" must be a file."
msgstr "Адресою «%s» має бути файл."

#: src/tdbush.c:513 src/tdbush.c:701
#, c-format
msgid "The location \"%s\" must be a directory."
msgstr "Адресою «%s» має бути каталог."

#: src/tdbush.c:525
msgid "Certificate nickname not specified."
msgstr "Псевдонім сертифіката не вказано."

#: src/tdbush.c:549 src/tdbush.c:1883
#, c-format
msgid "There is already a request with the nickname \"%s\"."
msgstr "Запит з псевдонімом «%s» вже існує."

#: src/tdbush.c:558 src/tdbush.c:1890
#, c-format
msgid "The nickname \"%s\" is not allowed."
msgstr "Псевдонім «%s» є некоректним."

#: src/tdbush.c:591
#, c-format
msgid "Certificate at same location is already used by request \"%s\"."
msgstr "Сертифікат з цією адресою вже використовується за запитом «%s»."

#: src/tdbush.c:620
#, c-format
msgid "Key storage type \"%s\" not supported."
msgstr "Підтримки типу сховищ ключів «%s» не передбачено."

#: src/tdbush.c:642 src/tdbush.c:684
msgid "Key storage location not specified."
msgstr "Адресу сховища ключів не вказано."

#: src/tdbush.c:713
msgid "Key nickname not specified."
msgstr "Псевдонім ключа не вказано."

#: src/tdbush.c:763
#, c-format
msgid "Key at same location is already used by request \"%s\"."
msgstr "Ключ за вказаною адресою вже використано запитом «%s»."

#: src/tdbush.c:815
msgid "No such CA."
msgstr "Такої служби сертифікації (CA) не виявлено."

#: src/tdbush.c:1902
#, c-format
msgid "Certificate authority \"%s\" not known."
msgstr "Невідома служба сертифікації «%s»."

#: src/tdbush.c:2000
msgid "Unrecognized parameter or wrong value type."
msgstr "Невідомий параметр або помилковий тип значення."

