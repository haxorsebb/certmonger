msgid "\tCA: %s\n"
msgstr "\tCA: %s\n"

#: src/getcert.c:2296
#, c-format
msgid "\tissuer: %s\n"
msgstr "\tвидавець: %s\n"

#: src/getcert.c:2297
#, c-format
msgid "\tsubject: %s\n"
msgstr "\tпризначення: %s\n"

