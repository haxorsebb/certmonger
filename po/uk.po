msgid "* General options:\n"
msgstr "* Загальні параметри:\n"

#: src/getcert.c:3491
msgid "  -c CA\tlist only requests and certs associated with this CA\n"
msgstr "  -c CA\tПоказати список лише тих запитів та сертифікатів, які пов’язано з вказаною службою сертифікації (CA)\n"

