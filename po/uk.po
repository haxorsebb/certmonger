msgid "  -S\t\tconnect to the certmonger service on the system bus\n"
msgstr "  -S\t\tВстановити зв’язок зі службою certmonger за допомогою системного каналу\n"

#: src/getcert.c:2657 src/getcert.c:2698 src/getcert.c:2722 src/getcert.c:2761
msgid "  -s\t\tconnect to the certmonger service on the session bus\n"
msgstr "  -s\t\tВстановити зв’язок зі службою certmonger за допомогою каналу сеансу\n"

