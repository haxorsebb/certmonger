msgstr "невідоме"

#: src/getcert.c:1813
msgid "\temail: "
msgstr "\tел. пошта: "

#: src/getcert.c:1819
msgid "\tdns: "
msgstr "\tdns: "

#: src/getcert.c:1825
msgid "\tprincipal name: "
msgstr "\tреєстраційний запис: "

