msgstr "* Якщо для зберігання даних використовуються файли:\n"

#: src/getcert.c:4617 src/getcert.c:4667 src/getcert.c:4714
msgid "  -k FILE\tPEM file for private key\n"
msgstr "  -k ФАЙЛ\tФайл PEM закритого ключа\n"

#: src/getcert.c:4618 src/getcert.c:4668 src/getcert.c:4715
msgid "  -f FILE\tPEM file for certificate (only valid with -k)\n"
msgstr "  -f ФАЙЛ\tФайл PEM сертифіката (працюватиме, лише якщо вказано -k)\n"

#: src/getcert.c:4619
msgid "* If keys are to be encrypted:\n"
msgstr "* Якщо ключі слід зашифрувати:\n"

#: src/getcert.c:4620 src/getcert.c:4670 src/getcert.c:4739 src/getcert.c:4786
msgid "  -p FILE\tfile which holds the encryption PIN\n"
msgstr "  -p ФАЙЛ\tФайл, у якому зберігається PIN-код шифрування\n"

#: src/getcert.c:4621 src/getcert.c:4671 src/getcert.c:4740 src/getcert.c:4787
msgid "  -P PIN\tPIN value\n"
msgstr "  -P PIN\tЗначення PIN-коду шифрування\n"

#: src/getcert.c:4623 src/getcert.c:4673 src/getcert.c:4717 src/getcert.c:4753
#: src/getcert.c:4800 src/getcert.c:4824 src/getcert.c:4861 src/getcert.c:4871
#: src/getcert.c:4889 src/getcert.c:4904 src/getcert.c:4921 src/getcert.c:4935
#: src/getcert.c:4953 src/getcert.c:4967
msgid "Optional arguments:\n"
msgstr "Необов’язкові аргументи:\n"

#: src/getcert.c:4624 src/getcert.c:4674 src/getcert.c:4754 src/getcert.c:4801
msgid "* Certificate handling settings:\n"
msgstr "* Параметри обробки сертифікатів:\n"

#: src/getcert.c:4625
msgid "  -I NAME\tnickname to assign to the request\n"
msgstr "  -I НАЗВА\tпсевдонім, який слід пов’язати з запитом\n"

#: src/getcert.c:4626
msgid "  -G TYPE\ttype of key to be generated if one is not already in place\n"
msgstr ""
"  -G ТИП\tтип ключа, який слід створити, якщо не буде виявлено готового\n"

#: src/getcert.c:4627
msgid "  -g SIZE\tsize of key to be generated if one is not already in place\n"
msgstr ""
"  -g РОЗМІР\tрозмір ключа, який слід створити, якщо не буде виявлено "
"готового, у бітах\n"

#: src/getcert.c:4628 src/getcert.c:4676
msgid ""
"  -r\t\tattempt to renew the certificate when expiration nears (default)\n"
msgstr ""
"  -r\t\tСпробувати оновити сертифікат, якщо наближається завершення строку "
"дії (типова поведінка)\n"

#: src/getcert.c:4629 src/getcert.c:4677
msgid "  -R\t\tdon't attempt to renew the certificate when expiration nears\n"
msgstr ""
"  -R\t\tНе намагатися оновити сертифікат, якщо наближається завершення "
"строку дії\n"

#: src/getcert.c:4631 src/getcert.c:4679
msgid "  -c CA\t\tuse the specified CA rather than the default\n"
msgstr ""
"  -c CA\t\tвикористовувати вказану службу сертифікації (CA), а не типову\n"

#: src/getcert.c:4633 src/getcert.c:4681 src/getcert.c:4759 src/getcert.c:4806
msgid ""
"  -T PROFILE\task the CA to process the request using the named profile or "
"template\n"
msgstr ""
"  -T ПРОФІЛЬ\tпопросити CA обробити запит з використанням вказаного профілю "
"або шаблона\n"

#: src/getcert.c:4634
msgid "* Parameters for the signing request:\n"
msgstr "* Параметри запиту щодо підписування:\n"

#: src/getcert.c:4635 src/getcert.c:4743 src/getcert.c:4790
msgid "  -N NAME\tset requested subject name (default: CN=<hostname>)\n"
msgstr "  -N НАЗВА\tВстановити бажане призначення (Типово: CN=<назва вузла>)\n"

#: src/getcert.c:4636 src/getcert.c:4744 src/getcert.c:4791
msgid "  -U EXTUSAGE\tset requested extended key usage OID\n"
msgstr ""
"  -U ДОД.ВИКОР.\tВстановити додаткове використання ключа за допомогою OID\n"

#: src/getcert.c:4637 src/getcert.c:4684 src/getcert.c:4745 src/getcert.c:4792
msgid "  -u KEYUSAGE\tset requested key usage value\n"
msgstr "  -u ВИКОРИСТАННЯ встановити вказане значення використання ключа\n"

#: src/getcert.c:4638 src/getcert.c:4746 src/getcert.c:4793
msgid "  -K NAME\tset requested principal name\n"
msgstr "  -K НАЗВА\tВстановити вказану назву реєстраційного запису\n"

#: src/getcert.c:4639 src/getcert.c:4747 src/getcert.c:4794
msgid "  -D DNSNAME\tset requested DNS name\n"
msgstr "  -D НАЗВА-DNS\tвстановити вказану назву за DNS\n"

#: src/getcert.c:4640 src/getcert.c:4748 src/getcert.c:4795
msgid "  -E EMAIL\tset requested email address\n"
msgstr "  -E ЕЛ.ПОШТА\tвстановити вказану адресу електронної пошти\n"

#: src/getcert.c:4641 src/getcert.c:4749 src/getcert.c:4796
msgid "  -A ADDRESS\tset requested IP address\n"
msgstr "  -A АДРЕСА\tвстановити вказану IP-адресу\n"

#: src/getcert.c:4642 src/getcert.c:4689 src/getcert.c:4750 src/getcert.c:4797
