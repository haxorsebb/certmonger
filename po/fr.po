msgid "  -B\tcommand to run before saving the certificate\n"
msgstr "  -B\tcommande à lancer avant de sauvegarder le certificat\n"

#: src/getcert.c:3017 src/getcert.c:3061 src/getcert.c:3127
msgid "  -C\tcommand to run after saving the certificate\n"
msgstr "  -C\tcommande à lancer après avoir sauvegardé le certificat\n"

