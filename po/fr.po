msgid "  -E EMAIL\toverride requested email address\n"
msgstr "  -E EMAIL\toutrepasse l'adresse e-mail demandée\n"

#: src/getcert.c:3055
msgid "  -A ADDRESS\toverride requested IP address\n"
msgstr "  -A ADRESSE\toutrepasse l'adresse IP demandée\n"

