#: src/getcert.c:1943
#, c-format
msgid "Resubmitting \"%s\".\n"
msgstr "Nouvelle soumission de « %s ».\n"

#: src/getcert.c:1949
#, c-format
msgid "Error attempting to submit \"%s\" to \"%s\".\n"
msgstr "Erreur en tentant de soumettre « %s » à « %s ».\n"

#: src/getcert.c:1952
#, c-format
msgid "Error attempting to submit \"%s\".\n"
msgstr "Erreur en tentant de soumettre « %s ».\n"

