msgstr "Utilisation : %s request [options]\n"

#: src/getcert.c:2981 src/getcert.c:3026 src/getcert.c:3070 src/getcert.c:3092
msgid "Required arguments:\n"
msgstr "Arguments requis :\n"

#: src/getcert.c:2982 src/getcert.c:3029 src/getcert.c:3073 src/getcert.c:3095
#: src/getcert.c:3145
msgid "* If using an NSS database for storage:\n"
msgstr "* Si vous utilisez une base de données NSS pour le stockage :\n"

#: src/getcert.c:2983 src/getcert.c:3030 src/getcert.c:3074 src/getcert.c:3096
msgid "  -d DIR\tNSS database for key and cert\n"
msgstr "  -d RÉPERTOIRES\tNSS base de données pour les clés et certificats\n"

#: src/getcert.c:2984 src/getcert.c:3031 src/getcert.c:3075 src/getcert.c:3097
msgid "  -n NAME\tnickname for NSS-based storage (only valid with -d)\n"
msgstr "  -n NOM\tsurnom pour le stockage NSS-base (valide uniquement avec -d)\n"

#: src/getcert.c:2985 src/getcert.c:3032 src/getcert.c:3076 src/getcert.c:3098
msgid ""
"  -t NAME\toptional token name for NSS-based storage (only valid with -d)\n"
msgstr "  -t NOM\tnom de jeton optionel pour le stockage NSS-base (valide uniquement avec -d)\n"

#: src/getcert.c:2986 src/getcert.c:3033 src/getcert.c:3077 src/getcert.c:3099
#: src/getcert.c:3148
msgid "* If using files for storage:\n"
msgstr "* Si vous utilisez des fichiers de stockage :\n"

#: src/getcert.c:2987 src/getcert.c:3034 src/getcert.c:3078
msgid "  -k FILE\tPEM file for private key\n"
msgstr "  -k FICHIER\tPEM fichier pour une clé privée\n"

#: src/getcert.c:2988 src/getcert.c:3035 src/getcert.c:3079
msgid "  -f FILE\tPEM file for certificate (only valid with -k)\n"
msgstr "  -f FICHIER\tPEM fichier du certificat (valide uniquement avec -k)\n"

#: src/getcert.c:2989
msgid "* If keys are to be encrypted:\n"
msgstr "* Si les clés sont à chiffrer :\n"

#: src/getcert.c:2990 src/getcert.c:3037 src/getcert.c:3103
msgid "  -p FILE\tfile which holds the encryption PIN\n"
msgstr "  -p FICHIER\tfichier qui contient le code PIN de chiffrement\n"

#: src/getcert.c:2991 src/getcert.c:3038 src/getcert.c:3104
msgid "  -P PIN\tPIN value\n"
msgstr "  -P PIN\tvaleur PIN\n"

#: src/getcert.c:2993 src/getcert.c:3040 src/getcert.c:3081 src/getcert.c:3115
#: src/getcert.c:3136 src/getcert.c:3160 src/getcert.c:3175
msgid "Optional arguments:\n"
msgstr "Arguments optionnels :\n"

#: src/getcert.c:2994 src/getcert.c:3041 src/getcert.c:3116
msgid "* Certificate handling settings:\n"
msgstr "* Paramètres de gestion du certificat :\n"

#: src/getcert.c:2995
msgid "  -I NAME\tnickname to assign to the request\n"
msgstr "  -I NOM\tnom à attribuer à la demande\n"

#: src/getcert.c:2996
msgid "  -G TYPE\ttype of key to be generated if one is not already in place\n"
msgstr "  -G TYPE\ttype de la clé à créer si aucune n'existe déjà\n"

#: src/getcert.c:2997
msgid "  -g SIZE\tsize of key to be generated if one is not already in place\n"
msgstr "  -g TAILLE\ttaille de la clé à générer si elle n'est pas déjà en place\n"

#: src/getcert.c:2998 src/getcert.c:3043
msgid "  -r\t\tattempt to renew the certificate when expiration nears (default)\n"
msgstr "  -r\t\ttente de renouveler le certificat lorsque l'expiration approche (par défaut)\n"

#: src/getcert.c:2999 src/getcert.c:3044
msgid "  -R\t\tdon't attempt to renew the certificate when expiration nears\n"
msgstr "  -R\t\tne pas tenter de renouveler le certificat lorsque l'expiration approche\n"

#: src/getcert.c:3001 src/getcert.c:3046
msgid "  -c CA\t\tuse the specified CA rather than the default\n"
msgstr "  -c AC\t\tutiliser l'autorité de certification spécifié, plutôt que celui par défaut\n"

#: src/getcert.c:3003 src/getcert.c:3048 src/getcert.c:3121
msgid ""
"  -T PROFILE\task the CA to process the request using the named profile or "
"template\n"
msgstr "  -T PROFIL\tinterroger le CA pour traiter la requête en utilisant le profil nommé ou le modèle\n"

#: src/getcert.c:3004
msgid "* Parameters for the signing request:\n"
msgstr "* Paramètres de la requête de signature :\n"

#: src/getcert.c:3005 src/getcert.c:3107
msgid "  -N NAME\tset requested subject name (default: CN=<hostname>)\n"
msgstr "  -N NOM\tdéfinit le nom du sujet demandé (par défaut: CN=<nom d'hôte>)\n"

#: src/getcert.c:3006 src/getcert.c:3108
msgid "  -U EXTUSAGE\tset requested extended key usage OID\n"
msgstr "  -U EXTUSAGE\tdéfinit l'étendu de l'utilisation d'une clé OID demandé\n"

#: src/getcert.c:3007 src/getcert.c:3051 src/getcert.c:3109
msgid "  -u KEYUSAGE\tset requested key usage value\n"
msgstr "  -u USAGECLÉ\tconfigure la valeur requise d'usage de la clé\n"

#: src/getcert.c:3008 src/getcert.c:3110
msgid "  -K NAME\tset requested principal name\n"
msgstr "  -K NOM\tdéfinit le nom principal demandé\n"

#: src/getcert.c:3009 src/getcert.c:3111
msgid "  -D DNSNAME\tset requested DNS name\n"
msgstr "  -D NOMDNS\tdéfinit le nom DNS demandé\n"

#: src/getcert.c:3010 src/getcert.c:3112
msgid "  -E EMAIL\tset requested email address\n"
msgstr "  -E EMAIL\tdéfinit l'adresse e-mail demandé\n"

#: src/getcert.c:3011 src/getcert.c:3113
msgid "  -A ADDRESS\tset requested IP address\n"
msgstr "  -A ADRESSE\tdéfinit l'adresse IP demandée\n"

