msgid "  -F\tfile in which to store the CA's certificates\n"
msgstr ""

#: src/getcert.c:3019 src/getcert.c:3063 src/getcert.c:3129
msgid "  -a\tNSS database in which to store the CA's certificates\n"
msgstr ""

