msgid "  -c CA\t\tuse the specified CA rather than the current one\n"
msgstr "  -c AC\t\tutilise l'autorité de certification spécifié plutôt que l'actuel\n"

#: src/getcert.c:3134
#, c-format
msgid "Usage: %s list [options]\n"
msgstr "Utilisation : %s list [options]\n"

#: src/getcert.c:3137 src/getcert.c:3162 src/getcert.c:3177
msgid "* General options:\n"
msgstr "* Options générales :\n"

#: src/getcert.c:3139
msgid "  -c CA\tlist only requests and certs associated with this CA\n"
msgstr "  -c AC\tliste seulement les requêtes et les certificats associés à une autorité de certification\n"

