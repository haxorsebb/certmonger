msgstr "* Paramètres de la requête de signature au moment du renouvellement :\n"

#: src/getcert.c:3050
msgid "  -U EXTUSAGE\toverride requested extended key usage OID\n"
msgstr "  -U EXTUSAGE\toutrepasse la requête d'utilisation d'une clé OID étendue\n"

