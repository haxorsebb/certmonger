msgid "  -n NAME\tonly list requests and certs which use this nickname\n"
msgstr "  -n NAME\tn'afficher que les requêtes et certificats utilisant ce pseudo\n"

#: src/getcert.c:3149
msgid "  -f FILE\tonly list requests and certs stored in this PEM file\n"
msgstr "  -f FILE\tn'afficher que les requêtes et certificats stockés dans ce fichier PEM\n"

#: src/getcert.c:3151 src/getcert.c:3166 src/getcert.c:3181
msgid "  -S\tconnect to the certmonger service on the system bus\n"
msgstr "  -S\tconnecte le service certmonger sur le bus système\n"

