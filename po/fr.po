#: src/getcert.c:2245
#, c-format
msgid "%s - client certificate enrollment tool\n"
msgstr "%s - outil d'inscription du certificat client\n"

#: src/getcert.c:2249
#, c-format
msgid "Usage: %s request [options]\n"
msgstr "Utilisation : %s request [options]\n"

#: src/getcert.c:2251 src/getcert.c:2288 src/getcert.c:2325 src/getcert.c:2347
msgid "Required arguments:\n"
msgstr "Arguments requis :\n"

#: src/getcert.c:2252 src/getcert.c:2291 src/getcert.c:2328 src/getcert.c:2350
#: src/getcert.c:2393
msgid "* If using an NSS database for storage:\n"
msgstr "* Si vous utilisez une base de données NSS pour le stockage :\n"

#: src/getcert.c:2253 src/getcert.c:2292 src/getcert.c:2329 src/getcert.c:2351
msgid "  -d DIR\tNSS database for key and cert\n"
msgstr "  -d RÉPERTOIRES\tNSS base de données pour les clés et certificats\n"

#: src/getcert.c:2254 src/getcert.c:2293 src/getcert.c:2330 src/getcert.c:2352
msgid "  -n NAME\tnickname for NSS-based storage (only valid with -d)\n"
msgstr ""
"  -n NOM\tsurnom pour le stockage NSS-base (valide uniquement avec -d)\n"

#: src/getcert.c:2255 src/getcert.c:2294 src/getcert.c:2331 src/getcert.c:2353
msgid ""
"  -t NAME\toptional token name for NSS-based storage (only valid with -d)\n"
msgstr ""
"  -t NOM\tnom de jeton optionel pour le stockage NSS-base (valide uniquement "
"avec -d)\n"

#: src/getcert.c:2256 src/getcert.c:2295 src/getcert.c:2332 src/getcert.c:2354
#: src/getcert.c:2396
msgid "* If using files for storage:\n"
msgstr "* Si vous utilisez des fichiers de stockage :\n"

#: src/getcert.c:2257 src/getcert.c:2296 src/getcert.c:2333
msgid "  -k FILE\tPEM file for private key\n"
msgstr "  -k FICHIER\tPEM fichier pour une clé privée\n"

#: src/getcert.c:2258 src/getcert.c:2297 src/getcert.c:2334
msgid "  -f FILE\tPEM file for certificate (only valid with -k)\n"
msgstr "  -f FICHIER\tPEM fichier du certificat (valide uniquement avec -k)\n"

#: src/getcert.c:2259
msgid "* If keys are to be encrypted:\n"
msgstr "* Si les clés sont à chiffrer :\n"

#: src/getcert.c:2260 src/getcert.c:2299 src/getcert.c:2358
msgid "  -p FILE\tfile which holds the encryption PIN\n"
msgstr "  -p FICHIER\tfichier qui contient le code PIN de chiffrement\n"

#: src/getcert.c:2261 src/getcert.c:2300 src/getcert.c:2359
msgid "  -P PIN\tPIN value\n"
msgstr "  -P PIN\tvaleur PIN\n"

#: src/getcert.c:2263 src/getcert.c:2302 src/getcert.c:2336 src/getcert.c:2368
#: src/getcert.c:2384 src/getcert.c:2408
msgid "Optional arguments:\n"
msgstr "Arguments optionnels :\n"

#: src/getcert.c:2264 src/getcert.c:2303 src/getcert.c:2369
msgid "* Certificate handling settings:\n"
msgstr "* Paramètres de gestion du certificat :\n"

#: src/getcert.c:2265
msgid "  -I NAME\tnickname to assign to the request\n"
msgstr "  -I NOM\tnom à attribuer à la demande\n"

#: src/getcert.c:2266
msgid "  -g SIZE\tsize of key to be generated if one is not already in place\n"
msgstr ""
"  -g TAILLE\ttaille de la clé à générer si elle n'est pas déjà en place\n"

#: src/getcert.c:2267 src/getcert.c:2305
msgid ""
"  -r\t\tattempt to renew the certificate when expiration nears (default)\n"
msgstr ""
"  -r\t\ttente de renouveler le certificat lorsque l'expiration approche (par "
"défaut)\n"

#: src/getcert.c:2268 src/getcert.c:2306
msgid "  -R\t\tdon't attempt to renew the certificate when expiration nears\n"
msgstr ""
"  -R\t\tne pas tenter de renouveler le certificat lorsque l'expiration "
"approche\n"

#: src/getcert.c:2270 src/getcert.c:2308
msgid "  -c CA\t\tuse the specified CA rather than the default\n"
msgstr ""
"  -c AC\t\tutiliser l'autorité de certification spécifié, plutôt que celui "
"par défaut\n"

#: src/getcert.c:2272
msgid "* Parameters for the signing request:\n"
msgstr "* Paramètres de la requête de signature :\n"

#: src/getcert.c:2273 src/getcert.c:2362
msgid "  -N NAME\tset requested subject name (default: CN=<hostname>)\n"
msgstr ""
"  -N NOM\tdéfinit le nom du sujet demandé (par défaut: CN=<nom d'hôte>)\n"

#: src/getcert.c:2274 src/getcert.c:2363
msgid "  -U EXTUSAGE\tset requested extended key usage OID\n"
msgstr ""
"  -U EXTUSAGE\tdéfinit l'étendu de l'utilisation d'une clé OID demandé\n"

#: src/getcert.c:2275 src/getcert.c:2364
msgid "  -K NAME\tset requested principal name\n"
msgstr "  -K NOM\tdéfinit le nom principal demandé\n"

#: src/getcert.c:2276 src/getcert.c:2365
msgid "  -D DNSNAME\tset requested DNS name\n"
msgstr "  -D NOMDNS\tdéfinit le nom DNS demandé\n"

#: src/getcert.c:2277 src/getcert.c:2366
msgid "  -E EMAIL\tset requested email address\n"
msgstr "  -E EMAIL\tdéfinit l'adresse e-mail demandé\n"

#: src/getcert.c:2278 src/getcert.c:2315 src/getcert.c:2337 src/getcert.c:2374
#: src/getcert.c:2398 src/getcert.c:2413
msgid "* Bus options:\n"
msgstr "* Options du Bus :\n"

#: src/getcert.c:2279 src/getcert.c:2316 src/getcert.c:2338 src/getcert.c:2375
msgid "  -S\t\tconnect to the certmonger service on the system bus\n"
msgstr "  -S\t\tconnecte le service certmonger sur le bus système\n"

#: src/getcert.c:2280 src/getcert.c:2317 src/getcert.c:2339 src/getcert.c:2376
msgid "  -s\t\tconnect to the certmonger service on the session bus\n"
msgstr "  -s\t\tconnecte le service certmonger sur le bus de session\n"

#: src/getcert.c:2281 src/getcert.c:2318 src/getcert.c:2340 src/getcert.c:2377
#: src/getcert.c:2401 src/getcert.c:2416
msgid "* Other options:\n"
msgstr "* Autres options :\n"

#: src/getcert.c:2282 src/getcert.c:2319 src/getcert.c:2341 src/getcert.c:2378
#: src/getcert.c:2402 src/getcert.c:2417
msgid "  -v\treport all details of errors\n"
msgstr "  -v\trapporte tous les détails des erreurs\n"

#: src/getcert.c:2286
#, c-format
msgid "Usage: %s start-tracking [options]\n"
msgstr "Utilisation : %s start-tracking [options]\n"

#: src/getcert.c:2289
msgid "* If modifying an existing request:\n"
msgstr "* Si vous modifiez une requête existante :\n"

#: src/getcert.c:2290
msgid "  -i NAME\tnickname of an existing tracking request\n"
msgstr "  -i NOM\tnom d'une demande de suivi existante\n"

#: src/getcert.c:2298 src/getcert.c:2357
msgid "* If keys are encrypted:\n"
msgstr "* Si les clés sont chiffrées :\n"

#: src/getcert.c:2304
msgid "  -I NAME\tnickname to give to tracking request\n"
msgstr "  -I NOM\tnom à donner à la demande de suivi\n"

#: src/getcert.c:2310
msgid "* Parameters for the signing request at renewal time:\n"
msgstr ""
"* Paramètres de la requête de signature au moment du renouvellement :\n"

#: src/getcert.c:2311
msgid "  -U EXTUSAGE\toverride requested extended key usage OID\n"
msgstr ""
"  -U EXTUSAGE\toutrepasse la requête d'utilisation d'une clé OID étendue\n"

#: src/getcert.c:2312
msgid "  -K NAME\toverride requested principal name\n"
msgstr "  -K NOM\toutrepasse le nom principal demandé\n"

#: src/getcert.c:2313
msgid "  -D DNSNAME\toverride requested DNS name\n"
msgstr "  -D NOMDNS\toutrepasse le nom DNS demandé\n"

#: src/getcert.c:2314
msgid "  -E EMAIL\toverride requested email address\n"
msgstr "  -E EMAIL\toutrepasse l'adresse e-mail demandée\n"

#: src/getcert.c:2323
#, c-format
msgid "Usage: %s stop-tracking [options]\n"
msgstr "Utilisation : %s stop-tracking [options]\n"

#: src/getcert.c:2326 src/getcert.c:2348
msgid "* By request identifier:\n"
msgstr "* En identifiant la demande :\n"

#: src/getcert.c:2327 src/getcert.c:2349 src/getcert.c:2392
msgid "  -i NAME\tnickname for tracking request\n"
msgstr "  -i NOM\tnom pour suivre la demande\n"

#: src/getcert.c:2345
#, c-format
msgid "Usage: %s resubmit [options]\n"
msgstr "Utilisation : %s resubmit [options]\n"

#: src/getcert.c:2355
msgid "  -f FILE\tPEM file for certificate\n"
msgstr "  -f FICHIER\tfichier PEM pour le certificat\n"

#: src/getcert.c:2361
msgid "* New parameter values for the signing request:\n"
msgstr "* Nouvelle valeur du paramètre pour la demande de signature :\n"

#: src/getcert.c:2370
msgid "  -I NAME\tnew nickname to give to tracking request\n"
