#: src/getcert.c:2660
#, c-format
msgid "Usage: %s request [options]\n"
msgstr "使い方: %s request [オプション]\n"

#: src/getcert.c:2662 src/getcert.c:2705 src/getcert.c:2747 src/getcert.c:2769
msgid "Required arguments:\n"
msgstr "必須の引数:\n"

#: src/getcert.c:2663 src/getcert.c:2708 src/getcert.c:2750 src/getcert.c:2772
#: src/getcert.c:2820
msgid "* If using an NSS database for storage:\n"
msgstr "* もしストレージに NSS データベースを使う場合:\n"

#: src/getcert.c:2664 src/getcert.c:2709 src/getcert.c:2751 src/getcert.c:2773
msgid "  -d DIR\tNSS database for key and cert\n"
msgstr "  -d DIR\tキーと証明書のための NSS データベース\n"

#: src/getcert.c:2665 src/getcert.c:2710 src/getcert.c:2752 src/getcert.c:2774
msgid "  -n NAME\tnickname for NSS-based storage (only valid with -d)\n"
msgstr ""
"  -n NAME\tNSS ベースストレージのためのニックネーム(-d オプションを指定した時"
"のみ有効)\n"

#: src/getcert.c:2666 src/getcert.c:2711 src/getcert.c:2753 src/getcert.c:2775
msgid ""
"  -t NAME\toptional token name for NSS-based storage (only valid with -d)\n"
msgstr ""
"  -t 名前\tNSS ベースの記憶領域のためのオプションのトークン名(-d オプションを"
"指定した時のみ有効)\n"

#: src/getcert.c:2667 src/getcert.c:2712 src/getcert.c:2754 src/getcert.c:2776
#: src/getcert.c:2823
msgid "* If using files for storage:\n"
msgstr "* もしストレージのためにファイルを使う時:\n"

#: src/getcert.c:2668 src/getcert.c:2713 src/getcert.c:2755
msgid "  -k FILE\tPEM file for private key\n"
msgstr "  -k FILE\tプライベートキーのための PEM ファイル\n"

#: src/getcert.c:2669 src/getcert.c:2714 src/getcert.c:2756
msgid "  -f FILE\tPEM file for certificate (only valid with -k)\n"
msgstr "  -f FILE\t証明書のための PEM ファイル (-k を指定した場合のみ有効)\n"

#: src/getcert.c:2670
msgid "* If keys are to be encrypted:\n"
msgstr "* もしキーが暗号化されていた場合:\n"

#: src/getcert.c:2671 src/getcert.c:2716 src/getcert.c:2780
msgid "  -p FILE\tfile which holds the encryption PIN\n"
msgstr "  -p FILE\t暗号化されたPIN コードが含まれるファイル\n"

#: src/getcert.c:2672 src/getcert.c:2717 src/getcert.c:2781
msgid "  -P PIN\tPIN value\n"
msgstr "  -P PIN\tPIN コードの値\n"

#: src/getcert.c:2674 src/getcert.c:2719 src/getcert.c:2758 src/getcert.c:2792
#: src/getcert.c:2811 src/getcert.c:2835
msgid "Optional arguments:\n"
msgstr "任意の引数:\n"

#: src/getcert.c:2675 src/getcert.c:2720 src/getcert.c:2793
msgid "* Certificate handling settings:\n"
msgstr "* 証明書の処理方法の設定:\n"

#: src/getcert.c:2676
msgid "  -I NAME\tnickname to assign to the request\n"
msgstr "  -I NAME\tリクエストに割り当てるニックネーム\n"

#: src/getcert.c:2677
msgid "  -G TYPE\ttype of key to be generated if one is not already in place\n"
msgstr "  -G TYPE\tキーが存在しない場合に生成されるキーの形式\n"

#: src/getcert.c:2678
msgid "  -g SIZE\tsize of key to be generated if one is not already in place\n"
msgstr "  -g SIZE\tキーが存在しない場合に生成されるキーのビット長\n"

#: src/getcert.c:2679 src/getcert.c:2722
msgid ""
"  -r\t\tattempt to renew the certificate when expiration nears (default)\n"
msgstr "  -r\t\t有効期限が近づいている時に証明書を更新する(デフォルト)\n"

#: src/getcert.c:2680 src/getcert.c:2723
msgid "  -R\t\tdon't attempt to renew the certificate when expiration nears\n"
msgstr "  -R\t\t有効期限が近づいても証明書を更新しない\n"

#: src/getcert.c:2682 src/getcert.c:2725
msgid "  -c CA\t\tuse the specified CA rather than the default\n"
msgstr "  -c CA\t\t指定されたCAではなく、デフォルトを使用\n"

#: src/getcert.c:2684 src/getcert.c:2727 src/getcert.c:2798
msgid ""
"  -T PROFILE\task the CA to process the request using the named profile or "
"template\n"
msgstr ""
