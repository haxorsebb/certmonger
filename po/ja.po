msgstr "引数に該当したリクエストが見つかりません。\n"

#: src/getcert.c:1630
#, c-format
msgid "Request \"%s\" removed.\n"
msgstr "リクエスト \"%s\" は削除されました。\n"

#: src/getcert.c:1634
#, c-format
msgid "Request \"%s\" could not be removed.\n"
msgstr "リクエスト \"%s\" は削除できません。\n"

#: src/getcert.c:1924
#, c-format
msgid "Error modifying \"%s\".\n"
msgstr ""
"\"%s\" を変更中にエラーが発生しました。\n"
"\n"

#: src/getcert.c:1940
#, c-format
msgid "Resubmitting \"%s\" to \"%s\".\n"
msgstr "\"%s\" を \"%s\" へ再送中です。\n"

#: src/getcert.c:1943
#, c-format
msgid "Resubmitting \"%s\".\n"
msgstr "\"%s\" を再送中です。\n"

#: src/getcert.c:1949
#, c-format
msgid "Error attempting to submit \"%s\" to \"%s\".\n"
msgstr ""
"\"%s\" を \"%s\" へ送信中にエラーが発生しました。\n"
"\n"

#: src/getcert.c:1952
#, c-format
msgid "Error attempting to submit \"%s\".\n"
msgstr ""
"\"%s\" を送信中にエラーが発生しました。\n"
"\n"

