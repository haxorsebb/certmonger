#: src/getcert.c:2619
#, c-format
msgid "%s - client certificate enrollment tool\n"
msgstr "%s - クライアント証明書登録ツール\n"

#: src/getcert.c:2623
#, c-format
msgid "Usage: %s request [options]\n"
msgstr "使い方: %s request [オプション]\n"

#: src/getcert.c:2625 src/getcert.c:2667 src/getcert.c:2708 src/getcert.c:2730
msgid "Required arguments:\n"
msgstr "必須の引数:\n"

#: src/getcert.c:2626 src/getcert.c:2670 src/getcert.c:2711 src/getcert.c:2733
#: src/getcert.c:2780
msgid "* If using an NSS database for storage:\n"
msgstr "* もしストレージに NSS データベースを使う場合:\n"

#: src/getcert.c:2627 src/getcert.c:2671 src/getcert.c:2712 src/getcert.c:2734
msgid "  -d DIR\tNSS database for key and cert\n"
msgstr "  -d DIR\tキーと証明書のための NSS データベース\n"

#: src/getcert.c:2628 src/getcert.c:2672 src/getcert.c:2713 src/getcert.c:2735
msgid "  -n NAME\tnickname for NSS-based storage (only valid with -d)\n"
msgstr ""
"  -n NAME\tNSS ベースストレージのためのニックネーム(-d オプションを指定した時"
"のみ有効)\n"

#: src/getcert.c:2629 src/getcert.c:2673 src/getcert.c:2714 src/getcert.c:2736
msgid ""
"  -t NAME\toptional token name for NSS-based storage (only valid with -d)\n"
msgstr ""
"  -t 名前\tNSS ベースの記憶領域のためのオプションのトークン名(-d オプションを"
"指定した時のみ有効)\n"

#: src/getcert.c:2630 src/getcert.c:2674 src/getcert.c:2715 src/getcert.c:2737
#: src/getcert.c:2783
msgid "* If using files for storage:\n"
msgstr "* もしストレージのためにファイルを使う時:\n"

#: src/getcert.c:2631 src/getcert.c:2675 src/getcert.c:2716
msgid "  -k FILE\tPEM file for private key\n"
msgstr "  -k FILE\tプライベートキーのための PEM ファイル\n"

#: src/getcert.c:2632 src/getcert.c:2676 src/getcert.c:2717
msgid "  -f FILE\tPEM file for certificate (only valid with -k)\n"
msgstr "  -f FILE\t証明書のための PEM ファイル (-k を指定した場合のみ有効)\n"

#: src/getcert.c:2633
msgid "* If keys are to be encrypted:\n"
msgstr "* もしキーが暗号化されていた場合:\n"

#: src/getcert.c:2634 src/getcert.c:2678 src/getcert.c:2741
msgid "  -p FILE\tfile which holds the encryption PIN\n"
msgstr "  -p FILE\t暗号化されたPIN コードが含まれるファイル\n"

#: src/getcert.c:2635 src/getcert.c:2679 src/getcert.c:2742
msgid "  -P PIN\tPIN value\n"
msgstr "  -P PIN\tPIN コードの値\n"

#: src/getcert.c:2637 src/getcert.c:2681 src/getcert.c:2719 src/getcert.c:2752
#: src/getcert.c:2771 src/getcert.c:2795
msgid "Optional arguments:\n"
msgstr "任意の引数:\n"

#: src/getcert.c:2638 src/getcert.c:2682 src/getcert.c:2753
msgid "* Certificate handling settings:\n"
msgstr "* 証明書の処理方法の設定:\n"

#: src/getcert.c:2639
msgid "  -I NAME\tnickname to assign to the request\n"
msgstr "  -I NAME\tリクエストに割り当てるニックネーム\n"

#: src/getcert.c:2640
msgid "  -G TYPE\ttype of key to be generated if one is not already in place\n"
msgstr ""

#: src/getcert.c:2641
msgid "  -g SIZE\tsize of key to be generated if one is not already in place\n"
msgstr "  -g SIZE\tキーが存在しない場合に生成されるキーのビット長\n"

#: src/getcert.c:2642 src/getcert.c:2684
msgid ""
"  -r\t\tattempt to renew the certificate when expiration nears (default)\n"
msgstr "  -r\t\t有効期限が近づいている時に証明書を更新する(デフォルト)\n"

#: src/getcert.c:2643 src/getcert.c:2685
msgid "  -R\t\tdon't attempt to renew the certificate when expiration nears\n"
msgstr "  -R\t\t有効期限が近づいても証明書を更新しない\n"

#: src/getcert.c:2645 src/getcert.c:2687
msgid "  -c CA\t\tuse the specified CA rather than the default\n"
msgstr "  -c CA\t\t指定されたCAではなく、デフォルトを使用\n"

#: src/getcert.c:2647 src/getcert.c:2689 src/getcert.c:2758
msgid ""
"  -T PROFILE\task the CA to process the request using the named profile or "
"template\n"
msgstr ""
"  -T PROFILE\t名前つきプロファイルまたはテンプレートを使用して、CA がリクエス"
"トを処理するか確認します\n"

#: src/getcert.c:2648
msgid "* Parameters for the signing request:\n"
msgstr "* 署名中リクエストのパラメーター:\n"

#: src/getcert.c:2649 src/getcert.c:2745
msgid "  -N NAME\tset requested subject name (default: CN=<hostname>)\n"
msgstr ""
"  -N NAME\t要求されたサブジェクト名を設定 (デフォルト: CN=<ホスト名>)\n"

#: src/getcert.c:2650 src/getcert.c:2746
msgid "  -U EXTUSAGE\tset requested extended key usage OID\n"
