msgstr "パス \"%s\" はディレクトリーではありません。\n"

#: src/getcert.c:118
#, c-format
msgid "Path \"%s\": %s.\n"
msgstr "パス \"%s\": %s.\n"

#: src/getcert.c:157
#, c-format
