msgid "  -n NAME\tonly list requests and certs which use this nickname\n"
msgstr ""
"  -n NAVN<span class=\"whitespace other\" title=\"Tab\">»</span>oplister kun "
"forespørgsler og certs som bruger dette kaldenavn\n"

#: src/getcert.c:2742
msgid "  -f FILE\tonly list requests and certs stored in this PEM file\n"
msgstr ""
"  -f FIL<span class=\"whitespace other\" title=\"Tab\">»</span>oplister kun "
"forespørgsler og certs, som er gemt i denne PEM-fil\n"

