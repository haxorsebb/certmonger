msgstr "-c CA\t\tuse CA khusus lebih baik daripada saat ini\n"

#: src/getcert.c:1893
#, c-format
msgid "Usage: %s list [options]\n"
msgstr "Pemakaian:  %s list [options]\n"

#: src/getcert.c:1896
#: src/getcert.c:1912
msgid "* General options:\n"
msgstr "* Pilihan umum:\n"

#: src/getcert.c:1898
msgid "  -c CA\tlist only requests and certs associated with this CA\n"
msgstr "-c CA\tlist hanya permintaan dan pemastian kolega dengan CA ini\n"

