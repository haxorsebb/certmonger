msgstr "-t\tlist hanya informasi tentang jalannya sertifikat\n"

#: src/getcert.c:1903
#: src/getcert.c:1916
msgid "  -S\tconnect to the certmonger service on the system bus\n"
msgstr "-S\tconnect untuk layanan pemastian pada sistem bus\n"

#: src/getcert.c:1904
#: src/getcert.c:1917
msgid "  -s\tconnect to the certmonger service on the session bus\n"
msgstr "-s\tconnect untuk layanan pemastian pada pembahasan bus\n"

