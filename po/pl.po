#: src/getcert.c:1789
#, c-format
msgid "\tcertificate: type=%s,location='%s'%s%s%s%s%s\n"
msgstr "\tcertyfikat: typ=%s,położenie=\"%s\"%s%s%s%s%s\n"

#: src/getcert.c:1805
#, c-format
msgid "\tCA: %s\n"
msgstr "\tCA: %s\n"

#: src/getcert.c:1807
#, c-format
msgid "\tissuer: %s\n"
msgstr "\twystawca: %s\n"

#: src/getcert.c:1808
#, c-format
msgid "\tsubject: %s\n"
msgstr "\ttemat: %s\n"

#: src/getcert.c:1809
#, c-format
msgid "\texpires: %s\n"
msgstr "\twygasa: %s\n"

#: src/getcert.c:1810
msgid "unknown"
msgstr "nieznane"

#: src/getcert.c:1813
msgid "\temail: "
msgstr "\te-mail: "

#: src/getcert.c:1819
msgid "\tdns: "
msgstr "\tdns: "

#: src/getcert.c:1825
msgid "\tprincipal name: "
msgstr "\tnazwa naczelnika: "

#: src/getcert.c:1831
msgid "\teku: "
msgstr "\teku: "

