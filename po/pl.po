#, c-format
msgid "Server error.\n"
msgstr "Błąd serwera.\n"

#: src/getcert.c:90
#, c-format
msgid "Path \"%s\" is not absolute, attempting to use \"%s\" instead.\n"
msgstr ""
"Ścieżka \"%s\" nie jest bezwzględna, próbowanie użycia \"%s\" zamiast niej.\n"

#: src/getcert.c:95
#, c-format
msgid ""
"Path \"%s\" is not absolute, and there was an error determining the name of "
"the current directory.\n"
msgstr ""
"Ścieżka \"%s\" nie jest bezwzględna i wystąpił błąd podczas określania nazwy "
"bieżącego katalogu.\n"

#: src/getcert.c:113
#, c-format
msgid "Path \"%s\" is not a directory.\n"
msgstr "Ścieżka \"%s\" nie jest katalogiem.\n"

#: src/getcert.c:118
#, c-format
msgid "Path \"%s\": %s.\n"
msgstr "Ścieżka \"%s\": %s.\n"

#: src/getcert.c:157
#, c-format
msgid "Path \"%s\" is not a regular file.\n"
msgstr "Ścieżka \"%s\" nie jest zwykłym plikiem.\n"

#: src/getcert.c:234
#, c-format
msgid "Out of memory.\n"
msgstr "Brak pamięci.\n"

#: src/getcert.c:260
#, c-format
msgid "Error connecting to DBus.\n"
msgstr "Błąd podczas łączenia z D-Bus.\n"

#: src/getcert.c:261
#, c-format
msgid "Please verify that the message bus (D-Bus) service is running.\n"
msgstr ""
"Proszę sprawdzić, czy usługa magistrali komunikatów (D-Bus) jest "
"uruchomiona.\n"

#: src/getcert.c:268
#, c-format
msgid "Error creating DBus request message.\n"
msgstr "Błąd podczas tworzenia komunikatu żądania D-Bus.\n"

#: src/getcert.c:310
#, c-format
msgid "Error %s: %s\n"
msgstr "Błąd %s: %s\n"

#: src/getcert.c:314
#, c-format
msgid "Error %s\n"
msgstr "Błąd %s\n"

#: src/getcert.c:320
#, c-format
msgid "Error: %s\n"
msgstr "Błąd: %s\n"

#: src/getcert.c:322
#, c-format
msgid "Received error response from local %s service.\n"
msgstr "Otrzymano błędną odpowiedź z lokalnej usługi %s.\n"

#: src/getcert.c:328
#, c-format
msgid "No response received from %s service.\n"
msgstr "Nie otrzymano odpowiedzi z usługi %s.\n"

#: src/getcert.c:574 src/getcert.c:1265 src/getcert.c:1664
#, c-format
msgid "Error initializing Kerberos library: %s.\n"
msgstr "Błąd podczas inicjowania biblioteki Kerberos: %s.\n"

#: src/getcert.c:630 src/getcert.c:1333 src/getcert.c:1706
#, c-format
msgid "Could not evaluate OID \"%s\".\n"
msgstr "Nie można obliczyć OID \"%s\".\n"

#: src/getcert.c:640 src/getcert.c:1343 src/getcert.c:1716
#, c-format
msgid "Error parsing Kerberos principal name \"%s\": %s.\n"
msgstr "Błąd podczas przetwarzania nazwy naczelnika Kerberosa \"%s\": %s.\n"

#: src/getcert.c:648 src/getcert.c:1351 src/getcert.c:1724
#, c-format
msgid "Error unparsing Kerberos principal name \"%s\": %s.\n"
msgstr ""
"Błąd podczas odwracania przetworzenia nazwy naczelnika Kerberosa \"%s\": "
"%s.\n"

#: src/getcert.c:681 src/getcert.c:1384 src/getcert.c:1757 src/getcert.c:1995
#: src/getcert.c:2299
#, c-format
msgid "%s: invalid option -- '%c'\n"
msgstr "%s: nieprawidłowa opcja - \"%c\"\n"

#: src/getcert.c:689
#, c-format
msgid "Error: unused extra argument \"%s\".\n"
msgstr "Błąd: nieużywany dodatkowy parametr \"%s\".\n"

#: src/getcert.c:692 src/getcert.c:1394 src/getcert.c:1764 src/getcert.c:2002
#: src/getcert.c:2306
#, c-format
msgid "Error: unused extra arguments were supplied.\n"
msgstr "Błąd: podano nieużywane dodatkowe parametry.\n"

#: src/getcert.c:698 src/getcert.c:1400 src/getcert.c:1560 src/getcert.c:1787
#, c-format
msgid "Database location or nickname specified without the other.\n"
msgstr "Podano położenie bazy danych lub pseudonim bez drugiego parametru.\n"

#: src/getcert.c:704 src/getcert.c:1406 src/getcert.c:1566 src/getcert.c:1793
#, c-format
msgid "Database directory and certificate file both specified.\n"
msgstr "Określono zarówno katalog bazy danych, jak i plik certyfikatu.\n"

#: src/getcert.c:712 src/getcert.c:1574 src/getcert.c:1801
#, c-format
msgid ""
"None of database directory and nickname or certificate file specified.\n"
msgstr "Nie podano katalogu bazy danych i pseudonimu lub pliku certyfikatu.\n"

#: src/getcert.c:719 src/getcert.c:1422
#, c-format
msgid "Key and certificate can not both be saved to the same file.\n"
msgstr "Nie można zapisać klucza i certyfikatu do tego samego pliku.\n"

#: src/getcert.c:744
#, c-format
msgid ""
"The IPA backend requires the use of the -K option (principal name) when the -"
"N option (subject name) is used.\n"
msgstr ""
"Zaplecze IPA wymaga użycia opcji -K (nazwy naczelnika), kiedy używana jest "
"opcja -N (nazwa tematu).\n"

#: src/getcert.c:874 src/getcert.c:1204 src/getcert.c:1503 src/getcert.c:1821
#: src/getcert.c:2009
#, c-format
msgid "No CA with name \"%s\" found.\n"
msgstr "Nie odnaleziono CA o nazwie \"%s\".\n"

#: src/getcert.c:929 src/getcert.c:1219 src/getcert.c:1527 src/getcert.c:1607
#: src/getcert.c:1891
#, c-format
msgid "Error setting request arguments.\n"
msgstr "Błąd podczas ustawiania parametrów żądania.\n"

#: src/getcert.c:940
#, c-format
msgid "New signing request \"%s\" added.\n"
msgstr "Dodano nowe żądanie podpisania \"%s\".\n"

#: src/getcert.c:943
#, c-format
msgid "New signing request could not be added.\n"
msgstr "Nie można dodać nowego żądania podpisania.\n"

#: src/getcert.c:1230
#, c-format
msgid "New tracking request \"%s\" added.\n"
msgstr "Dodano nowe żądanie śledzenia \"%s\".\n"

#: src/getcert.c:1234
#, c-format
msgid "New tracking request could not be added.\n"
msgstr "Nie można dodać nowego żądania śledzenia.\n"

#: src/getcert.c:1415
#, c-format
msgid ""
"None of ID or database directory and nickname or certificate file "
"specified.\n"
msgstr ""
"Nie podano identyfikatora, albo katalogu bazy danych i pseudonimu, albo "
"pliku certyfikatu.\n"

#: src/getcert.c:1541
#, c-format
msgid "Request \"%s\" modified.\n"
msgstr "Zmodyfikowano żądanie \"%s\".\n"

#: src/getcert.c:1545
#, c-format
msgid "Request \"%s\" could not be modified.\n"
msgstr "Nie można zmodyfikować żądania \"%s\".\n"

#: src/getcert.c:1553 src/getcert.c:1780 src/getcert.c:2016
#, c-format
msgid "No request found with specified nickname.\n"
msgstr "Nie odnaleziono żądania dla podanego pseudonimu.\n"

#: src/getcert.c:1598 src/getcert.c:1807 src/getcert.c:2027
#, c-format
msgid "No request found that matched arguments.\n"
msgstr "Nie odnaleziono żądania pasującego do parametrów.\n"

#: src/getcert.c:1617
#, c-format
msgid "Request \"%s\" removed.\n"
msgstr "Usunięto żądanie \"%s\".\n"

#: src/getcert.c:1621
#, c-format
msgid "Request \"%s\" could not be removed.\n"
msgstr "Nie można usunąć żądania \"%s\".\n"

#: src/getcert.c:1905
#, c-format
msgid "Error modifying \"%s\".\n"
msgstr "Błąd podczas modyfikowania \"%s\".\n"

#: src/getcert.c:1921
#, c-format
msgid "Resubmitting \"%s\" to \"%s\".\n"
msgstr "Ponowne wysyłanie \"%s\" do \"%s\".\n"

#: src/getcert.c:1924
#, c-format
msgid "Resubmitting \"%s\".\n"
msgstr "Ponowne wysyłanie \"%s\".\n"

#: src/getcert.c:1930
#, c-format
msgid "Error attempting to submit \"%s\" to \"%s\".\n"
msgstr "Błąd podczas próby wysłania \"%s\" do \"%s\".\n"

#: src/getcert.c:1933
#, c-format
msgid "Error attempting to submit \"%s\".\n"
msgstr "Błąd podczas próby wysłania \"%s\".\n"

#: src/getcert.c:2038
#, c-format
msgid "Number of certificates and requests being tracked: %d.\n"
msgstr "Liczba śledzonych certyfikatów i żądań: %d.\n"

#: src/getcert.c:2156
#, c-format
msgid "Request ID '%s':\n"
msgstr "Identyfikator żądania \"%s\":\n"

#: src/getcert.c:2157
#, c-format
msgid "\tstatus: %s\n"
msgstr "\tstan: %s\n"

