#, c-format
msgid "Unable to read signing request.\n"
msgstr "Nie można odczytać żądania podpisania.\n"

#: src/certmaster.c:157 src/ipa.c:203
#, c-format
msgid "Error setting up for XMLRPC.\n"
msgstr "Błąd podczas ustawiania dla XML-RPC.\n"

#: src/certmaster.c:179 src/getcert.c:236 src/getcert.c:254 src/getcert.c:272
#: src/getcert.c:290 src/getcert.c:308 src/getcert.c:325 src/getcert.c:702
#: src/getcert.c:976 src/getcert.c:1264 src/getcert.c:1335 src/getcert.c:1594
