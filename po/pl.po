#, c-format
msgid "Path \"%s\" is not absolute, using \"%s\" instead.\n"
msgstr "Ścieżka \"%s\" nie jest bezwzględna, używanie \"%s\" w zamian.\n"

#: src/getcert.c:92 src/getcert.c:129
#, c-format
msgid ""
"Path \"%s\" is not absolute, and there was an error determining the name of "
"the current directory.\n"
msgstr ""
"Ścieżka \"%s\" nie jest bezwzględna i wystąpił błąd podczas określania nazwy "
"bieżącego katalogu.\n"

#: src/getcert.c:148 src/getcert.c:174
#, c-format
msgid "Error connecting to DBus.\n"
msgstr "Błąd podczas łączenia z D-Bus.\n"

#: src/getcert.c:181
#, c-format
msgid "Error creating DBus request message.\n"
msgstr "Błąd podczas tworzenia komunikatu żądania D-Bus.\n"

#: src/getcert.c:194
msgid "Insufficient access.  Please retry operation as root.\n"
msgstr "Niewystarczający dostęp. Proszę powtórzyć działanie jako root.\n"

#: src/getcert.c:198
msgid "Please verify that the certmonger service has been started.\n"
msgstr "Proszę sprawdzić, czy usługa certmonger została uruchomiona.\n"

#: src/getcert.c:201
msgid "Please verify that the certmonger service is still running.\n"
msgstr "Proszę sprawdzić, czy usługa certmonger jest nadal uruchomiona.\n"

#: src/getcert.c:204
msgid "Please verify that the message bus (D-Bus) service is running.\n"
msgstr ""
"Proszę sprawdzić, czy usługa magistrali komunikatów (D-Bus) jest "
"uruchomiona.\n"

#: src/getcert.c:238
#, c-format
msgid "Error %s: %s\n"
msgstr "Błąd %s: %s\n"

#: src/getcert.c:242
#, c-format
msgid "Error %s\n"
