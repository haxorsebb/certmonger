msgstr "Wewnętrzny błąd: brak odpowiedzi na \"%s?%s\".\n"

#: src/getcert.c:91
#, c-format
msgid "Path \"%s\" is not absolute, attempting to use \"%s\" instead.\n"
msgstr ""
"Ścieżka \"%s\" nie jest bezwzględna, próbowanie użycia \"%s\" zamiast niej.\n"

#: src/getcert.c:96
#, c-format
msgid ""
"Path \"%s\" is not absolute, and there was an error determining the name of "
"the current directory.\n"
msgstr ""
"Ścieżka \"%s\" nie jest bezwzględna i wystąpił błąd podczas określania nazwy "
"bieżącego katalogu.\n"

#: src/getcert.c:118
#, c-format
msgid "Path \"%s\": insufficient permissions.\n"
msgstr "Ścieżka \"%s\": niewystarczające uprawnienia.\n"

#: src/getcert.c:124
#, c-format
msgid "Path \"%s\" is not a directory.\n"
msgstr "Ścieżka \"%s\" nie jest katalogiem.\n"

#: src/getcert.c:130
#, c-format
msgid "Path \"%s\": %s.\n"
msgstr "Ścieżka \"%s\": %s.\n"

#: src/getcert.c:170
#, c-format
msgid "Path \"%s\" is not a regular file.\n"
msgstr "Ścieżka \"%s\" nie jest zwykłym plikiem.\n"

#: src/getcert.c:247
#, c-format
msgid "Out of memory.\n"
msgstr "Brak pamięci.\n"

#: src/getcert.c:273
#, c-format
msgid "Error connecting to DBus.\n"
msgstr "Błąd podczas łączenia z D-Bus.\n"

#: src/getcert.c:274 src/tdbusm.c:1958
#, c-format
msgid "Please verify that the message bus (D-Bus) service is running.\n"
msgstr ""
"Proszę sprawdzić, czy usługa magistrali komunikatów (D-Bus) jest "
"uruchomiona.\n"

#: src/getcert.c:281
#, c-format
msgid "Error creating DBus request message.\n"
msgstr "Błąd podczas tworzenia komunikatu żądania D-Bus.\n"

#: src/getcert.c:323
#, c-format
msgid "Error %s: %s\n"
msgstr "Błąd %s: %s\n"

#: src/getcert.c:327
#, c-format
msgid "Error %s\n"
msgstr "Błąd %s\n"

#: src/getcert.c:333
#, c-format
msgid "Error: %s\n"
msgstr "Błąd: %s\n"

#: src/getcert.c:335
#, c-format
msgid "Received error response from local %s service.\n"
msgstr "Otrzymano błędną odpowiedź z lokalnej usługi %s.\n"

#: src/getcert.c:341
#, c-format
msgid "No response received from %s service.\n"
msgstr "Nie otrzymano odpowiedzi z usługi %s.\n"

#: src/getcert.c:588 src/getcert.c:1381 src/getcert.c:1840
#, c-format
msgid "Error initializing Kerberos library: %s.\n"
msgstr "Błąd podczas inicjowania biblioteki Kerberos: %s.\n"

#: src/getcert.c:632
#, c-format
msgid "No support for generating \"%s\" keys.\n"
msgstr "Brak obsługi tworzenia kluczy \"%s\".\n"

#: src/getcert.c:634
#, c-format
msgid "Known key types include:"
msgstr "Znane typy kluczy:"

#: src/getcert.c:671 src/getcert.c:1451 src/getcert.c:1885
#, c-format
msgid "Unrecognized keyUsage \"%s\".\n"
msgstr "Nierozpoznane użycie klucza \"%s\".\n"

#: src/getcert.c:681 src/getcert.c:1461 src/getcert.c:1895
#, c-format
msgid "Could not evaluate OID \"%s\".\n"
msgstr "Nie można obliczyć OID \"%s\".\n"

#: src/getcert.c:691 src/getcert.c:1471 src/getcert.c:1905
#, c-format
msgid "Error parsing Kerberos principal name \"%s\": %s.\n"
msgstr "Błąd podczas przetwarzania nazwy naczelnika Kerberosa \"%s\": %s.\n"

#: src/getcert.c:699 src/getcert.c:1479 src/getcert.c:1913
#, c-format
msgid "Error unparsing Kerberos principal name \"%s\": %s.\n"
msgstr ""
"Błąd podczas odwracania przetworzenia nazwy naczelnika Kerberosa \"%s\": "
"%s.\n"

#: src/getcert.c:740 src/getcert.c:1520 src/getcert.c:1954 src/getcert.c:2233
#: src/getcert.c:2581
#, c-format
msgid "%s: option requires an argument -- '%c'\n"
msgstr "%s: opcja wymaga parametru - \"%c\"\n"

