msgstr "* Wartości nowych parametrów dla żądania podpisania:\n"

#: src/getcert.c:2161
msgid "  -I NAME\tnew nickname to give to tracking request\n"
msgstr "  -I NAZWA\tnowy pseudonim przyznany śledzonemu żądaniu\n"

#: src/getcert.c:2163
msgid "  -c CA\t\tuse the specified CA rather than the current one\n"
msgstr "  -c CA\t\tużywa podanego CA zamiast bieżącego\n"

#: src/getcert.c:2173
#, c-format
msgid "Usage: %s list [options]\n"
msgstr "Użycie: %s list [opcje]\n"

#: src/getcert.c:2176 src/getcert.c:2194
msgid "* General options:\n"
msgstr "* Ogólne opcje:\n"

#: src/getcert.c:2178
msgid "  -c CA\tlist only requests and certs associated with this CA\n"
msgstr "  -c CA\twyświetla tylko żądania i certyfikaty powiązane z tym CA\n"

#: src/getcert.c:2180
msgid "  -r\tlist only information about outstanding requests\n"
msgstr "  -r\twyświetla informacje tylko o oczekujących żądaniach\n"

#: src/getcert.c:2181
msgid "  -t\tlist only information about tracked certificates\n"
msgstr "  -t\twyświetla informacje tylko o śledzonych certyfikatach\n"

#: src/getcert.c:2183 src/getcert.c:2198
msgid "  -S\tconnect to the certmonger service on the system bus\n"
msgstr "  -S\tłączy się z uslugą certmonger przez magistralę systemową\n"

#: src/getcert.c:2184 src/getcert.c:2199
msgid "  -s\tconnect to the certmonger service on the session bus\n"
msgstr "  -s\tłączy się z usługą certmonger przez magistralę sesji\n"

#: src/getcert.c:2190
#, c-format
msgid "Usage: %s list-cas [options]\n"
msgstr "Użycie: %s list-cas [opcje]\n"

#: src/getcert.c:2195
msgid "  -c CA\tlist only information about the CA with this name\n"
msgstr "  -c CA\twyświetla informacje tylko o CA o tej nazwie\n"

#: src/getcert.c:2252
#, c-format
msgid "%s: unrecognized command\n"
msgstr "%s: nierozpoznane polecenie\n"

#: src/ipa.c:123
#, c-format
msgid "Unable to determine location of CA's XMLRPC server.\n"
msgstr "Nie można określić położenia serwera XML-RPC CA.\n"

#: src/ipa.c:131
#, c-format
msgid "Unable to determine principal name for signing request.\n"
msgstr "Nie można określić nazwy naczelnika dla żądania podpisania.\n"

