#, c-format
msgid "Usage: %s start-tracking [options]\n"
msgstr "Użycie: %s start-tracking [opcje]\n"

#: src/getcert.c:2080
msgid "* If modifying an existing request:\n"
msgstr "* Podczas modyfikowania istniejącego żądania:\n"

#: src/getcert.c:2081
msgid "  -i NAME\tnickname of an existing tracking request\n"
msgstr "  -i NAZWA\tpseudonim istniejącego żądania śledzenia\n"

