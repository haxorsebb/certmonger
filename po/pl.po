msgid "\tstatus: %s\n"
msgstr "\tstan: %s\n"

#: src/getcert.c:1596
#, c-format
msgid "\tca-error: %s\n"
msgstr "\tbłąd-ca: %s\n"

#: src/getcert.c:1598
#, c-format
msgid "\tstuck: %s\n"
msgstr "\tzatkanie: %s\n"

#: src/getcert.c:1618
#, c-format
msgid "\tkey pair storage: %s%s%s%s%s%s%s%s%s%s%s%s%s%s\n"
msgstr "\tprzechowywanie pary kluczy: %s%s%s%s%s%s%s%s%s%s%s%s%s%s\n"

#: src/getcert.c:1619
msgid "type="
msgstr "typ="

#: src/getcert.c:1620
msgid ",location='"
msgstr ",położenie='"

#: src/getcert.c:1621 src/getcert.c:1635
