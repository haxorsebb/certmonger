#, c-format
msgid "\tcertificate: type=%s,location='%s'"
msgstr "\tcertyfikat: typ=%s,położenie=\"%s\""

#: src/getcert.c:2228
#, c-format
msgid "\tCA: %s\n"
msgstr "\tCA: %s\n"

#: src/getcert.c:2230
#, c-format
msgid "\tissuer: %s\n"
msgstr "\twystawca: %s\n"

#: src/getcert.c:2231
#, c-format
msgid "\tsubject: %s\n"
msgstr "\ttemat: %s\n"

#: src/getcert.c:2232
#, c-format
msgid "\texpires: %s\n"
msgstr "\twygasa: %s\n"

