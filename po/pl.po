msgid ",pin="
msgstr ",pin="

#: src/getcert.c:1691
msgid ",pinfile="
msgstr ",plik_pin="

#: src/getcert.c:1700
#, c-format
msgid "\tcertificate: type=%s,location='%s'%s%s%s%s%s\n"
msgstr "\tcertyfikat: typ=%s,położenie=\"%s\"%s%s%s%s%s\n"

#: src/getcert.c:1716
#, c-format
msgid "\tCA: %s\n"
msgstr "\tCA: %s\n"

#: src/getcert.c:1718
#, c-format
msgid "\tissuer: %s\n"
msgstr "\twystawca: %s\n"

#: src/getcert.c:1719
#, c-format
msgid "\tsubject: %s\n"
msgstr "\ttemat: %s\n"

#: src/getcert.c:1720
#, c-format
msgid "\texpires: %s\n"
msgstr "\twygasa: %s\n"

#: src/getcert.c:1721
msgid "unknown"
msgstr "nieznane"

#: src/getcert.c:1724
msgid "\temail: "
msgstr "\te-mail: "

#: src/getcert.c:1730
msgid "\tdns: "
msgstr "\tdns: "

#: src/getcert.c:1736
msgid "\tprincipal name: "
msgstr "\tnazwa naczelnika: "

#: src/getcert.c:1742
msgid "\teku: "
msgstr "\teku: "

#: src/getcert.c:1746
#, c-format
msgid "\ttrack: %s\n"
msgstr "\tścieżka: %s\n"

#: src/getcert.c:1750
#, c-format
msgid "\tauto-renew: %s\n"
msgstr "\tautomatyczne-odnawianie: %s\n"

#: src/getcert.c:1792
#, c-format
msgid "CA '%s':\n"
msgstr "CA \"%s\":\n"

#: src/getcert.c:1799
#, c-format
msgid "\tca-type: %s\n"
msgstr "\ttyp-ca: %s\n"

#: src/getcert.c:1801
#, c-format
msgid "\thelper-location: %s\n"
msgstr "\tpołożenie-pomocnika: %s\n"

#: src/getcert.c:1805
#, c-format
msgid "\tnext-serial-number: %s\n"
msgstr "\tnastępny-numer-seryjny: %s\n"

#: src/getcert.c:1813
#, c-format
msgid "\tknown-issuer-names:\n"
msgstr "\tnazwy-znanych-wystawców: \n"

#: src/getcert.c:1839
#, c-format
msgid "%s - client certificate enrollment tool\n"
msgstr "%s - narzędzie kwalifikowania certyfikatów klientów\n"

#: src/getcert.c:1843
#, c-format
msgid "Usage: %s request [options]\n"
msgstr "Użycie: %s request [opcje]\n"

#: src/getcert.c:1845 src/getcert.c:1880 src/getcert.c:1911 src/getcert.c:1931
msgid "Required arguments:\n"
msgstr "Wymagane parametry:\n"

#: src/getcert.c:1846 src/getcert.c:1883 src/getcert.c:1914 src/getcert.c:1934
msgid "* If using an NSS database for storage:\n"
msgstr "* Podczas używania bazy NSS do przechowywania danych:\n"

#: src/getcert.c:1847 src/getcert.c:1884 src/getcert.c:1915 src/getcert.c:1935
msgid "  -d DIR\tNSS database for key and cert\n"
msgstr "  -d KAT\tbaza danych NSS dla klucza i certyfikatu\n"

#: src/getcert.c:1848 src/getcert.c:1885 src/getcert.c:1916 src/getcert.c:1936
msgid "  -n NAME\tnickname for NSS-based storage (only valid with -d)\n"
msgstr ""
"  -n NAZWA\tpseudonim dla przechowywania danych opartego na NSS (prawidłowe "
"tylko z opcją -d)\n"

#: src/getcert.c:1849 src/getcert.c:1886 src/getcert.c:1917 src/getcert.c:1937
msgid ""
"  -t NAME\toptional token name for NSS-based storage (only valid with -d)\n"
msgstr ""
"  -t NAZWA\topcjonalna nazwa tokenu dla przechowywania opartego na NSS "
"(prawidłowe tylko z opcją -d)\n"

#: src/getcert.c:1850 src/getcert.c:1887 src/getcert.c:1918 src/getcert.c:1938
msgid "* If using files for storage:\n"
msgstr "* Podczas używania plików do przechowywania:\n"

#: src/getcert.c:1851 src/getcert.c:1888 src/getcert.c:1919
msgid "  -k FILE\tPEM file for private key\n"
msgstr "  -k PLIK\tplik PEM dla klucza prywatnego\n"

#: src/getcert.c:1852 src/getcert.c:1889 src/getcert.c:1920
msgid "  -f FILE\tPEM file for certificate (only valid with -k)\n"
msgstr "  -f PLIK\tplik PEM dla certyfikatu (prawidłowe tylko z opcją -k)\n"

#: src/getcert.c:1853
msgid "* If keys are to be encrypted:\n"
msgstr "* Jeśli klucze mają zostać zaszyfrowane:\n"

#: src/getcert.c:1854 src/getcert.c:1892 src/getcert.c:1942
msgid "  -p FILE\tfile which holds the encryption PIN\n"
msgstr "  -p PLIK\tplik przechowujący kod PIN szyfrowania\n"

#: src/getcert.c:1855 src/getcert.c:1893 src/getcert.c:1943
msgid "  -P PIN\tPIN value\n"
msgstr "  -P PIN\twartość kodu PIN\n"

#: src/getcert.c:1857 src/getcert.c:1895 src/getcert.c:1922 src/getcert.c:1952
#: src/getcert.c:1966 src/getcert.c:1981
msgid "Optional arguments:\n"
msgstr "Opcjonalne parametry:\n"

#: src/getcert.c:1858 src/getcert.c:1896 src/getcert.c:1953
msgid "* Certificate handling settings:\n"
msgstr "* Ustawienia obsługiwania certyfikatów:\n"

#: src/getcert.c:1859
msgid "  -I NAME\tnickname to assign to the request\n"
msgstr "  -I NAZWA\tpseudonim do przydzielenia żądaniu\n"

#: src/getcert.c:1860
msgid "  -g SIZE\tsize of key to be generated if one is not already in place\n"
msgstr ""
"  -g ROZMIAR\trozmiar klucza do utworzenia, jeśli jeszcze nie ma żadnego\n"

#: src/getcert.c:1861 src/getcert.c:1898
msgid ""
"  -r\t\tattempt to renew the certificate when expiration nears (default)\n"
msgstr ""
"  -r\t\tpróbuje odnowić certyfikat, kiedy zbliża się jego wygaszenie "
"(domyślnie)\n"

#: src/getcert.c:1862 src/getcert.c:1899
msgid "  -R\t\tdon't attempt to renew the certificate when expiration nears\n"
msgstr ""
"  -R\t\tnie próbuje odnowić certyfikatu, kiedy zbliża się jego wygaszenie\n"

#: src/getcert.c:1864 src/getcert.c:1901
msgid "  -c CA\t\tuse the specified CA rather than the default\n"
msgstr "  -c CA\t\tużywa podanego CA zamiast domyślnego\n"

#: src/getcert.c:1866
msgid "* Parameters for the signing request:\n"
msgstr "* Parametry do żądania podpisania:\n"

#: src/getcert.c:1867 src/getcert.c:1946
msgid "  -N NAME\tset requested subject name (default: CN=<hostname>)\n"
msgstr ""
"  -N NAZWA\tustawia żądaną nazwę tematu (domyślnie: CN=<nazwa_komputera>)\n"

#: src/getcert.c:1868 src/getcert.c:1947
msgid "  -U EXTUSAGE\tset requested extended key usage OID\n"
msgstr ""
"  -U UŻYCIE_ZEWNĘTRZNE\tustawia żądany OID użycia rozszerzonego klucza\n"

#: src/getcert.c:1869 src/getcert.c:1948
msgid "  -K NAME\tset requested principal name\n"
msgstr "  -K NAZWA\tustawia żądaną nazwę naczelnika\n"

#: src/getcert.c:1870 src/getcert.c:1949
msgid "  -D DNSNAME\tset requested DNS name\n"
msgstr "  -D NAZWA_DNS\tustawia żądaną nazwę DNS\n"

#: src/getcert.c:1871 src/getcert.c:1950
msgid "  -E EMAIL\tset requested email address\n"
msgstr "  -E E-MAIL\tustawia żądany adres e-mail\n"

#: src/getcert.c:1872 src/getcert.c:1903 src/getcert.c:1923 src/getcert.c:1958
#: src/getcert.c:1973 src/getcert.c:1986
msgid "* Bus options:\n"
msgstr "* Opcje magistrali:\n"

#: src/getcert.c:1873 src/getcert.c:1904 src/getcert.c:1924 src/getcert.c:1959
msgid "  -S\t\tconnect to the certmonger service on the system bus\n"
msgstr "  -S\t\tłączy się z usługą certmonger przez magistralę systemową\n"

#: src/getcert.c:1874 src/getcert.c:1905 src/getcert.c:1925 src/getcert.c:1960
msgid "  -s\t\tconnect to the certmonger service on the session bus\n"
msgstr "  -s\t\tłączy się z usługą certmonger przez magistralę sesji\n"

#: src/getcert.c:1878
#, c-format
msgid "Usage: %s start-tracking [options]\n"
msgstr "Użycie: %s start-tracking [opcje]\n"

#: src/getcert.c:1881
msgid "* If modifying an existing request:\n"
msgstr "* Podczas modyfikowania istniejącego żądania:\n"

#: src/getcert.c:1882
msgid "  -i NAME\tnickname of an existing tracking request\n"
msgstr "  -i NAZWA\tpseudonim istniejącego żądania śledzenia\n"

#: src/getcert.c:1891 src/getcert.c:1941
msgid "* If keys are encrypted:\n"
msgstr "* Jeśli klucze są zaszyfrowane:\n"

#: src/getcert.c:1897
msgid "  -I NAME\tnickname to give to tracking request\n"
msgstr "  -I NAZWA\tpseudonim do nadania śledzonemu żądaniu\n"

#: src/getcert.c:1909
#, c-format
msgid "Usage: %s stop-tracking [options]\n"
msgstr "Użycie: %s stop-tracking [opcje]\n"

#: src/getcert.c:1912 src/getcert.c:1932
msgid "* By request identifier:\n"
msgstr "* Według identyfikatora żądania:\n"

#: src/getcert.c:1913 src/getcert.c:1933
msgid "  -i NAME\tnickname for tracking request\n"
msgstr "  -i NAZWA\tpseudonim dla śledzonego żądania\n"

#: src/getcert.c:1929
#, c-format
msgid "Usage: %s resubmit [options]\n"
msgstr "Użycie: %s resubmit [opcje]\n"

#: src/getcert.c:1939
msgid "  -f FILE\tPEM file for certificate\n"
msgstr "  -f PLIK\tplik PEM dla certyfikatu\n"

#: src/getcert.c:1945
msgid "* New parameter values for the signing request:\n"
msgstr "* Wartości nowych parametrów dla żądania podpisania:\n"

#: src/getcert.c:1954
msgid "  -I NAME\tnew nickname to give to tracking request\n"
msgstr "  -I NAZWA\tnowy pseudonim przyznany śledzonemu żądaniu\n"

#: src/getcert.c:1956
msgid "  -c CA\t\tuse the specified CA rather than the current one\n"
msgstr "  -c CA\t\tużywa podanego CA zamiast bieżącego\n"

#: src/getcert.c:1964
#, c-format
msgid "Usage: %s list [options]\n"
msgstr "Użycie: %s list [opcje]\n"

#: src/getcert.c:1967 src/getcert.c:1983
msgid "* General options:\n"
msgstr "* Ogólne opcje:\n"

#: src/getcert.c:1969
msgid "  -c CA\tlist only requests and certs associated with this CA\n"
msgstr "  -c CA\twyświetla tylko żądania i certyfikaty powiązane z tym CA\n"

#: src/getcert.c:1971
msgid "  -r\tlist only information about outstanding requests\n"
msgstr "  -r\twyświetla informacje tylko o oczekujących żądaniach\n"

#: src/getcert.c:1972
msgid "  -t\tlist only information about tracked certificates\n"
msgstr "  -t\twyświetla informacje tylko o śledzonych certyfikatach\n"

#: src/getcert.c:1974 src/getcert.c:1987
msgid "  -S\tconnect to the certmonger service on the system bus\n"
msgstr "  -S\tłączy się z uslugą certmonger przez magistralę systemową\n"

#: src/getcert.c:1975 src/getcert.c:1988
msgid "  -s\tconnect to the certmonger service on the session bus\n"
msgstr "  -s\tłączy się z usługą certmonger przez magistralę sesji\n"

#: src/getcert.c:1979
#, c-format
msgid "Usage: %s list-cas [options]\n"
msgstr "Użycie: %s list-cas [opcje]\n"

#: src/getcert.c:1984
msgid "  -c CA\tlist only information about the CA with this name\n"
msgstr "  -c CA\twyświetla informacje tylko o CA o tej nazwie\n"

#: src/getcert.c:2039
#, c-format
msgid "%s: unrecognized command\n"
msgstr "%s: nierozpoznane polecenie\n"

#: src/ipa.c:122
#, c-format
msgid "Unable to determine location of CA's XMLRPC server.\n"
msgstr "Nie można określić położenia serwera XML-RPC CA.\n"

#: src/ipa.c:130
#, c-format
msgid "Unable to determine principal name for signing request.\n"
msgstr "Nie można określić nazwy naczelnika dla żądania podpisania.\n"

#: src/ipa.c:211
#, c-format
msgid ""
"Error setting up ccache for local \"host\" service using default keytab.\n"
