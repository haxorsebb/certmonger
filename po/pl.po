#, c-format
msgid ",token='%s'"
msgstr ",token=\"%s\""

#: src/getcert.c:2194
#, c-format
msgid ",pin='%s'"
msgstr ",pin=\"%s\""

#: src/getcert.c:2197
#, c-format
msgid ",pinfile='%s'"
msgstr ",plik_pinu=\"%s\""

