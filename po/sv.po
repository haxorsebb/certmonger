#: src/getcert.c:2370
#, c-format
msgid "%s - client certificate enrollment tool\n"
msgstr "%s - registreringsverktyg för klientcertifikat\n"

#: src/getcert.c:2374
#, c-format
msgid "Usage: %s request [options]\n"
msgstr "Användning: %s request [flaggor]\n"

#: src/getcert.c:2376 src/getcert.c:2414 src/getcert.c:2452 src/getcert.c:2474
msgid "Required arguments:\n"
msgstr "Obligatoriska argument:\n"

#: src/getcert.c:2377 src/getcert.c:2417 src/getcert.c:2455 src/getcert.c:2477
#: src/getcert.c:2521
msgid "* If using an NSS database for storage:\n"
msgstr "* Om du använder en NSS-databas för lagring:\n"

#: src/getcert.c:2378 src/getcert.c:2418 src/getcert.c:2456 src/getcert.c:2478
msgid "  -d DIR\tNSS database for key and cert\n"
msgstr "  -d KAT\tNSS-databas för nyckel och cert\n"

#: src/getcert.c:2379 src/getcert.c:2419 src/getcert.c:2457 src/getcert.c:2479
msgid "  -n NAME\tnickname for NSS-based storage (only valid with -d)\n"
msgstr "  -n NAMN\tsmeknamn för NSS-baserad lagring (endast giltigt med -d)\n"

#: src/getcert.c:2380 src/getcert.c:2420 src/getcert.c:2458 src/getcert.c:2480
msgid ""
"  -t NAME\toptional token name for NSS-based storage (only valid with -d)\n"
msgstr ""
"  -t NAMN\tfrivilligt symbolnamn för NSS-baserad lagring (endast giltig med -"
"d)\n"

#: src/getcert.c:2381 src/getcert.c:2421 src/getcert.c:2459 src/getcert.c:2481
#: src/getcert.c:2524
msgid "* If using files for storage:\n"
msgstr "* Om du använder filer för lagring:\n"

#: src/getcert.c:2382 src/getcert.c:2422 src/getcert.c:2460
msgid "  -k FILE\tPEM file for private key\n"
msgstr "  -k FIL\tPEM-fil för privat nyckel\n"

#: src/getcert.c:2383 src/getcert.c:2423 src/getcert.c:2461
msgid "  -f FILE\tPEM file for certificate (only valid with -k)\n"
msgstr "  -f FIL\tPEM-fil för certifikat (endast giltigt med -k)\n"

#: src/getcert.c:2384
msgid "* If keys are to be encrypted:\n"
msgstr "* Om nycklar skall krypteras:\n"

#: src/getcert.c:2385 src/getcert.c:2425 src/getcert.c:2485
msgid "  -p FILE\tfile which holds the encryption PIN\n"
msgstr "  -p FIL\tfil som håller PIN för kryptering\n"

#: src/getcert.c:2386 src/getcert.c:2426 src/getcert.c:2486
msgid "  -P PIN\tPIN value\n"
msgstr "  -P PIN\tPIN-värde\n"

#: src/getcert.c:2388 src/getcert.c:2428 src/getcert.c:2463 src/getcert.c:2495
#: src/getcert.c:2512 src/getcert.c:2536
msgid "Optional arguments:\n"
msgstr "Valfria argument:\n"

#: src/getcert.c:2389 src/getcert.c:2429 src/getcert.c:2496
msgid "* Certificate handling settings:\n"
msgstr "* Inställningar för certifikathantering:\n"

#: src/getcert.c:2390
msgid "  -I NAME\tnickname to assign to the request\n"
msgstr "  -I NAMN\tsmeknamn att tilldela till begäran\n"

#: src/getcert.c:2391
msgid "  -g SIZE\tsize of key to be generated if one is not already in place\n"
msgstr ""
"  -g STORLEK\tstorlek på nyckel som skall genereras om det inte redan finns "
"en\n"

#: src/getcert.c:2392 src/getcert.c:2431
msgid ""
"  -r\t\tattempt to renew the certificate when expiration nears (default)\n"
msgstr ""
"  -r\t\tförsök att förnya certifikatet när utgångsdatumet närmar sig "
"(standard)\n"

#: src/getcert.c:2393 src/getcert.c:2432
msgid "  -R\t\tdon't attempt to renew the certificate when expiration nears\n"
msgstr ""
"  -R\t\tförsök inte förnya certifikatet när utgångsdatumet närmar sig\n"

#: src/getcert.c:2395 src/getcert.c:2434
msgid "  -c CA\t\tuse the specified CA rather than the default\n"
msgstr "  -c CA\t\tanvänd angiven CA istället för standard\n"

#: src/getcert.c:2397
msgid "* Parameters for the signing request:\n"
msgstr "* Parametrar för signeringsbegäran:\n"

#: src/getcert.c:2398 src/getcert.c:2489
msgid "  -N NAME\tset requested subject name (default: CN=<hostname>)\n"
msgstr "  -N NAMN\tställ in begärt ämnesnamn (standard: CN=<värdnamn>)\n"

#: src/getcert.c:2399 src/getcert.c:2490
msgid "  -U EXTUSAGE\tset requested extended key usage OID\n"
msgstr "  -U EXTANV\tställ in begärd förlängd nyckelanvändning-OID\n"

#: src/getcert.c:2400 src/getcert.c:2491
msgid "  -K NAME\tset requested principal name\n"
msgstr "  -K NAMN\tställ in begärt huvudnamn\n"

#: src/getcert.c:2401 src/getcert.c:2492
msgid "  -D DNSNAME\tset requested DNS name\n"
msgstr "  -D DNS-NAMN\tställ in begärt DNS-namn\n"

#: src/getcert.c:2402 src/getcert.c:2493
msgid "  -E EMAIL\tset requested email address\n"
msgstr "  -E EPOST\tställ in begärd e-postadress\n"

#: src/getcert.c:2403 src/getcert.c:2441 src/getcert.c:2464 src/getcert.c:2501
#: src/getcert.c:2526 src/getcert.c:2541
msgid "* Bus options:\n"
msgstr "* Bussflaggor:\n"

#: src/getcert.c:2404 src/getcert.c:2442 src/getcert.c:2465 src/getcert.c:2502
msgid "  -S\t\tconnect to the certmonger service on the system bus\n"
msgstr "  -S\t\tanslut till tjänsten certmonger på systembussen\n"

#: src/getcert.c:2405 src/getcert.c:2443 src/getcert.c:2466 src/getcert.c:2503
msgid "  -s\t\tconnect to the certmonger service on the session bus\n"
msgstr "  -s\t\tanslut till tjänsten certmonger på sessionsbussen\n"

#: src/getcert.c:2406 src/getcert.c:2444 src/getcert.c:2467 src/getcert.c:2504
#: src/getcert.c:2529 src/getcert.c:2544
msgid "* Other options:\n"
msgstr "* Andra flaggor:\n"

#: src/getcert.c:2407 src/getcert.c:2445 src/getcert.c:2505
msgid "  -C\tcommand to run when saving the certificate\n"
msgstr ""

#: src/getcert.c:2408 src/getcert.c:2446 src/getcert.c:2468 src/getcert.c:2506
#: src/getcert.c:2530 src/getcert.c:2545
msgid "  -v\treport all details of errors\n"
msgstr "  -v\trapportera alla detaljer om fel\n"

#: src/getcert.c:2412
#, c-format
msgid "Usage: %s start-tracking [options]\n"
msgstr "Användning: %s start-tracking [flaggor]\n"

#: src/getcert.c:2415
msgid "* If modifying an existing request:\n"
msgstr "* Om du ändrar en befintlig begäran:\n"

#: src/getcert.c:2416
msgid "  -i NAME\tnickname of an existing tracking request\n"
msgstr "  -i NAMN\tsmeknamn på en befintlig spårningsbegäran\n"

#: src/getcert.c:2424 src/getcert.c:2484
msgid "* If keys are encrypted:\n"
msgstr "* Om nycklarna är krypterade:\n"

#: src/getcert.c:2430
msgid "  -I NAME\tnickname to give to tracking request\n"
msgstr "  -I NAMN\tsmeknamn att ge på spårningbegäran\n"

#: src/getcert.c:2436
msgid "* Parameters for the signing request at renewal time:\n"
msgstr "* Parametrar för signeringsbegäran vid förnyelsetidpunkten:\n"

#: src/getcert.c:2437
msgid "  -U EXTUSAGE\toverride requested extended key usage OID\n"
msgstr "  -U EXTANV\tåsidosätt begärd förlängd nyckelanvändning-OID\n"

#: src/getcert.c:2438
msgid "  -K NAME\toverride requested principal name\n"
msgstr "  -K NAMN\tåsidosätt begärt huvudnamn\n"

#: src/getcert.c:2439
msgid "  -D DNSNAME\toverride requested DNS name\n"
msgstr "  -D DNS-NAMN\tåsidosätt begärt DNS-namn\n"

#: src/getcert.c:2440
msgid "  -E EMAIL\toverride requested email address\n"
msgstr "  -E EMAIL\tåsidosätt begärd e-postadress\n"

#: src/getcert.c:2450
#, c-format
msgid "Usage: %s stop-tracking [options]\n"
msgstr "Användning: %s stop-tracking [flaggor]\n"

#: src/getcert.c:2453 src/getcert.c:2475
msgid "* By request identifier:\n"
msgstr "* Enligt identifierare för begäran:\n"

#: src/getcert.c:2454 src/getcert.c:2476 src/getcert.c:2520
msgid "  -i NAME\tnickname for tracking request\n"
msgstr "  -i NAMN\tsmeknamn för spårningsbegäran\n"

#: src/getcert.c:2472
#, c-format
msgid "Usage: %s resubmit [options]\n"
msgstr "Användning: %s resubmit [flaggor]\n"

#: src/getcert.c:2482
msgid "  -f FILE\tPEM file for certificate\n"
msgstr "  -f FIL\tPEM-fil för certifikat\n"

#: src/getcert.c:2488
msgid "* New parameter values for the signing request:\n"
msgstr "* Nya parametervärden för signeringsbegäran:\n"

#: src/getcert.c:2497
msgid "  -I NAME\tnew nickname to give to tracking request\n"
msgstr "  -I NAMN\tnytt smeknamn för att ge till spårningsbegäran\n"

#: src/getcert.c:2499
msgid "  -c CA\t\tuse the specified CA rather than the current one\n"
msgstr "  -c CA\t\tanvänd den angivna CA:n istället för den nuvarande\n"

#: src/getcert.c:2510
#, c-format
msgid "Usage: %s list [options]\n"
msgstr "Användning: %s list [flaggor]\n"

#: src/getcert.c:2513 src/getcert.c:2538
msgid "* General options:\n"
msgstr "* Allmänna flaggor:\n"

#: src/getcert.c:2515
msgid "  -c CA\tlist only requests and certs associated with this CA\n"
msgstr ""
"  -c CA\tlista endast begäran och certifikat associerade med denna CA\n"

#: src/getcert.c:2517
msgid "  -r\tlist only information about outstanding requests\n"
msgstr "  -r\tlista endast information om utestående begäran\n"

#: src/getcert.c:2518
msgid "  -t\tlist only information about tracked certificates\n"
msgstr "  -t\tlista endast information om spårade certifikat\n"

#: src/getcert.c:2519
msgid "* If selecting a specific request:\n"
msgstr "* Om du väljer en viss begäran:\n"

#: src/getcert.c:2522
msgid "  -d DIR\tonly list requests and certs which use this NSS database\n"
msgstr ""
"  -d KAT\tlista endast begäran och certifikat som använder denna NSS-"
"databas\n"

#: src/getcert.c:2523
msgid "  -n NAME\tonly list requests and certs which use this nickname\n"
msgstr ""
"  -n NAMN\tlista endast begäran och certifikat som använder detta smeknamn\n"

#: src/getcert.c:2525
msgid "  -f FILE\tonly list requests and certs stored in this PEM file\n"
msgstr ""
"  -f FIL\tlista endast begäran och certifikat lagrade i denna PEM-fil\n"

#: src/getcert.c:2527 src/getcert.c:2542
msgid "  -S\tconnect to the certmonger service on the system bus\n"
msgstr "  -S\tanslut till tjänsten certmonger på systembussen\n"

#: src/getcert.c:2528 src/getcert.c:2543
msgid "  -s\tconnect to the certmonger service on the session bus\n"
msgstr "  -s\tanslut till tjänsten certmonger på sessionsbussen\n"

#: src/getcert.c:2534
#, c-format
msgid "Usage: %s list-cas [options]\n"
msgstr "Användning: %s list-cas [flaggor]\n"

#: src/getcert.c:2539
msgid "  -c CA\tlist only information about the CA with this name\n"
msgstr "  -c CA\tlista endast information om CA:n med detta namn\n"

#: src/getcert.c:2596
#, c-format
msgid "%s: unrecognized command\n"
msgstr "%s: okänt kommando\n"

