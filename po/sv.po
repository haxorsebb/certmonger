msgstr "Ingen av databaskatalog och smeknamn eller certifikatfil angiven.\n"

#: src/getcert.c:634 src/getcert.c:1319
#, c-format
msgid "Key and certificate can not both be saved to the same file.\n"
msgstr "Nyckeln och certifikatet kan inte båda sparas i samma fil.\n"

#: src/getcert.c:659
#, c-format
msgid ""
"The IPA backend requires the use of the -K option (principal name) when the -"
"N option (subject name) is used.\n"
msgstr ""
"IPA-backänden kräver användning av -K-flaggan (huvudnamn) när -N-flaggan "
"(ämnesnamn) används.\n"

