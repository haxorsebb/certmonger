#: src/getcert.c:3137
#, c-format
msgid "Usage: %s request [options]\n"
msgstr "Användning: %s request [flaggor]\n"

#: src/getcert.c:3139 src/getcert.c:3185 src/getcert.c:3230 src/getcert.c:3252
msgid "Required arguments:\n"
msgstr "Obligatoriska argument:\n"

#: src/getcert.c:3140 src/getcert.c:3188 src/getcert.c:3233 src/getcert.c:3255
#: src/getcert.c:3306
msgid "* If using an NSS database for storage:\n"
msgstr "* Om du använder en NSS-databas för lagring:\n"

#: src/getcert.c:3141 src/getcert.c:3189 src/getcert.c:3234 src/getcert.c:3256
msgid "  -d DIR\tNSS database for key and cert\n"
msgstr "  -d KAT\tNSS-databas för nyckel och cert\n"

#: src/getcert.c:3142 src/getcert.c:3190 src/getcert.c:3235 src/getcert.c:3257
msgid "  -n NAME\tnickname for NSS-based storage (only valid with -d)\n"
msgstr "  -n NAMN\tsmeknamn för NSS-baserad lagring (endast giltigt med -d)\n"

#: src/getcert.c:3143 src/getcert.c:3191 src/getcert.c:3236 src/getcert.c:3258
msgid ""
"  -t NAME\toptional token name for NSS-based storage (only valid with -d)\n"
msgstr ""
"  -t NAMN\tfrivilligt symbolnamn för NSS-baserad lagring (endast giltig med -"
"d)\n"

#: src/getcert.c:3144 src/getcert.c:3192 src/getcert.c:3237 src/getcert.c:3259
#: src/getcert.c:3309
msgid "* If using files for storage:\n"
msgstr "* Om du använder filer för lagring:\n"

#: src/getcert.c:3145 src/getcert.c:3193 src/getcert.c:3238
msgid "  -k FILE\tPEM file for private key\n"
msgstr "  -k FIL\tPEM-fil för privat nyckel\n"

#: src/getcert.c:3146 src/getcert.c:3194 src/getcert.c:3239
msgid "  -f FILE\tPEM file for certificate (only valid with -k)\n"
msgstr "  -f FIL\tPEM-fil för certifikat (endast giltigt med -k)\n"

#: src/getcert.c:3147
msgid "* If keys are to be encrypted:\n"
msgstr "* Om nycklar skall krypteras:\n"

#: src/getcert.c:3148 src/getcert.c:3196 src/getcert.c:3263
msgid "  -p FILE\tfile which holds the encryption PIN\n"
msgstr "  -p FIL\tfil som håller PIN för kryptering\n"

#: src/getcert.c:3149 src/getcert.c:3197 src/getcert.c:3264
msgid "  -P PIN\tPIN value\n"
msgstr "  -P PIN\tPIN-värde\n"

#: src/getcert.c:3151 src/getcert.c:3199 src/getcert.c:3241 src/getcert.c:3275
#: src/getcert.c:3297 src/getcert.c:3321 src/getcert.c:3339 src/getcert.c:3354
msgid "Optional arguments:\n"
msgstr "Valfria argument:\n"

#: src/getcert.c:3152 src/getcert.c:3200 src/getcert.c:3276
msgid "* Certificate handling settings:\n"
msgstr "* Inställningar för certifikathantering:\n"

#: src/getcert.c:3153
msgid "  -I NAME\tnickname to assign to the request\n"
msgstr "  -I NAMN\tsmeknamn att tilldela till begäran\n"

#: src/getcert.c:3154
msgid "  -G TYPE\ttype of key to be generated if one is not already in place\n"
msgstr ""

#: src/getcert.c:3155
msgid "  -g SIZE\tsize of key to be generated if one is not already in place\n"
msgstr ""
"  -g STORLEK\tstorlek på nyckel som skall genereras om det inte redan finns "
"en\n"

#: src/getcert.c:3156 src/getcert.c:3202
msgid ""
"  -r\t\tattempt to renew the certificate when expiration nears (default)\n"
msgstr ""
"  -r\t\tförsök att förnya certifikatet när utgångsdatumet närmar sig "
"(standard)\n"

#: src/getcert.c:3157 src/getcert.c:3203
msgid "  -R\t\tdon't attempt to renew the certificate when expiration nears\n"
msgstr ""
"  -R\t\tförsök inte förnya certifikatet när utgångsdatumet närmar sig\n"

#: src/getcert.c:3159 src/getcert.c:3205
msgid "  -c CA\t\tuse the specified CA rather than the default\n"
msgstr "  -c CA\t\tanvänd angiven CA istället för standard\n"

#: src/getcert.c:3161 src/getcert.c:3207 src/getcert.c:3281
msgid ""
"  -T PROFILE\task the CA to process the request using the named profile or "
"template\n"
msgstr ""
"  -T PROFIL\tbe CA:n att bearbeta begäran med användning av den angivna "
"profilen eller mallen\n"

#: src/getcert.c:3162
msgid "* Parameters for the signing request:\n"
msgstr "* Parametrar för signeringsbegäran:\n"

#: src/getcert.c:3163 src/getcert.c:3267
msgid "  -N NAME\tset requested subject name (default: CN=<hostname>)\n"
msgstr "  -N NAMN\tställ in begärt ämnesnamn (standard: CN=<värdnamn>)\n"

#: src/getcert.c:3164 src/getcert.c:3268
