msgid "\tstatus: %s\n"
msgstr "        състояние: %s\n"

#: src/getcert.c:2186
#, c-format
msgid "\tca-error: %s\n"
msgstr "        CA-грешка: %s\n"

#: src/getcert.c:2188
#, c-format
msgid "\tstuck: %s\n"
msgstr "        останал: %s\n"

#: src/getcert.c:2208
#, c-format
msgid "\tkey pair storage: type=%s"
msgstr "        хранилище на ключови двойки: тип=%s"

#: src/getcert.c:2208
msgid "NONE"
msgstr "НИЩО"

