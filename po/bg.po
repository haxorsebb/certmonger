#, c-format
msgid "\tpre-save command: %s\n"
msgstr "\tpre-save команда: %s\n"

#: src/getcert.c:2462
#, c-format
msgid "\tpost-save command: %s\n"
msgstr "\tpost-save команда: %s\n"

