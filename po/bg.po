#, c-format
msgid ",pinfile='%s'"
msgstr ",пинфайл='%s'"

#: src/getcert.c:2233
#, c-format
msgid "\tcertificate: type=%s,location='%s'"
msgstr "        сертификат: тип=%s,местоположение='%s'"

#: src/getcert.c:2253
#, c-format
msgid "\tCA: %s\n"
msgstr "        CA: %s\n"

#: src/getcert.c:2255
#, c-format
msgid "\tissuer: %s\n"
msgstr "        издател: %s\n"

#: src/getcert.c:2256
#, c-format
msgid "\tsubject: %s\n"
msgstr "        обект: %s\n"

#: src/getcert.c:2257
#, c-format
msgid "\texpires: %s\n"
msgstr "        изтича на: %s\n"

#: src/getcert.c:2260
msgid "unknown"
msgstr "непознат"

