msgstr "No ha sido especificado un apodo de certificado."

#: src/tdbush.c:662 src/tdbush.c:2912
#, c-format
msgid "There is already a request with the nickname \"%s\"."
msgstr "Ya existe una petición con el apodo \"%s\"."

#: src/tdbush.c:698
#, c-format
msgid ""
"Certificate at same location is already used by request with nickname \"%s\"."
msgstr ""
"Un certificado en la misma ubicación ya está siendo utilizado por la "
"petición hecha con el alias \"%s\"."

#: src/tdbush.c:731
#, c-format
msgid "Key storage type \"%s\" not supported."
msgstr "No existe soporte para el tipo \"%s\" de llave de almacenamiento."

#: src/tdbush.c:757 src/tdbush.c:816
msgid "Key storage location not specified."
msgstr "No ha sido especificada una ubicación de la llave."

#: src/tdbush.c:850
msgid "Key nickname not specified."
msgstr "No ha sido especificado un apodo de llave."

#: src/tdbush.c:906
#, c-format
msgid "Key at same location is already used by request with nickname \"%s\"."
msgstr ""
"Una llave en la misma ubicación ya está siendo utilizada por la petición "
"hecha con el alias \"%s\"."

#: src/tdbush.c:1277
#, c-format
msgid "No support for key type \"%s\"."
msgstr "Sin soporte para tipo de llave %s\"."

#: src/tdbush.c:1358
msgid "No such CA."
msgstr "No existe el CA."

#: src/tdbush.c:2930
#, c-format
msgid "Certificate authority \"%s\" not known."
msgstr "No se conoce la autoridad \"%s\" del certifiicado. "

#: src/tdbush.c:3266
msgid "Unrecognized parameter or wrong value type."
msgstr "Parámetro irreconocible o tipo de valor erróneo."

#: src/tdbush.c:4679
msgid "Error parsing arguments."
msgstr "Error analizando argumentos."

#: src/tdbush.c:4733
msgid "Unrecognized property name."
msgstr "Nombre de propiedad no reconocido."

#: src/tdbusm.c:2092
msgid "Insufficient access.  Please retry operation as root.\n"
msgstr "Acceso insuficiente.  Por favor reintente la operanción como root.\n"

#: src/tdbusm.c:2096
msgid "Please verify that the certmonger service has been started.\n"
msgstr "Por favor verifique que el servicio certmonger ha sido arrancado.\n"

#: src/tdbusm.c:2099
msgid "Please verify that the certmonger service is still running.\n"
msgstr ""
"Por favor verifique que el servicio certmonger está todavía corriendo.\n"
