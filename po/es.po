msgid "  -c CA\t\tuse the specified CA rather than the current one\n"
msgstr "  -c CA\t\tutilizar el CA indicado en lugar del actual\n"

#: src/getcert.c:2382
#, c-format
msgid "Usage: %s list [options]\n"
msgstr "Utilización: %s lista [opciones]\n"

#: src/getcert.c:2385 src/getcert.c:2410
msgid "* General options:\n"
msgstr "* Opciones generales:\n"

#: src/getcert.c:2387
msgid "  -c CA\tlist only requests and certs associated with this CA\n"
msgstr ""
"  -c CA\tlista sólo las peticiones y los certificados asociados con este "
"CA\n"

#: src/getcert.c:2389
msgid "  -r\tlist only information about outstanding requests\n"
msgstr "  -r\tlista sólo la información acerca de peticiones destacadas\n"

#: src/getcert.c:2390
msgid "  -t\tlist only information about tracked certificates\n"
msgstr "  -t\tlista sólo información acerca de certificados en seguimiento\n"

#: src/getcert.c:2391
msgid "* If selecting a specific request:\n"
msgstr "* Si selecciona un pedido específico:\n"

#: src/getcert.c:2394
msgid "  -d DIR\tonly list requests and certs which use this NSS database\n"
msgstr ""
"  -d DIR<span class=\"whitespace other\" title=\"Tab\">»</span> sólo lista "
"los pedidos y certificados que usa esta base de datos NSS\n"

#: src/getcert.c:2395
msgid "  -n NAME\tonly list requests and certs which use this nickname\n"
msgstr ""
"  -n NOMBRE<span class=\"whitespace other\" title=\"Tab\">»</span>sólo lista"
" los pedidos y certificados que usan este apodo\n"

#: src/getcert.c:2397
msgid "  -f FILE\tonly list requests and certs stored in this PEM file\n"
msgstr ""
"  -f ARCHIVO <span class=\"whitespace other\" title=\"Tab\">»</span>sólo "
"lista los pedidos y certificados guardados en este archivo PEM\n"

#: src/getcert.c:2399 src/getcert.c:2414
msgid "  -S\tconnect to the certmonger service on the system bus\n"
msgstr "  -S\tconectar con el servicio certmonger en el bus del sistema\n"

#: src/getcert.c:2400 src/getcert.c:2415
msgid "  -s\tconnect to the certmonger service on the session bus\n"
msgstr "  -s\tconectar con el servicio certmonger en el bus de la sesión\n"

#: src/getcert.c:2406
#, c-format
msgid "Usage: %s list-cas [options]\n"
msgstr "Utilización: %s list-cas [opciones]\n"

#: src/getcert.c:2411
msgid "  -c CA\tlist only information about the CA with this name\n"
msgstr "  -c CA\tlista sólo la información de este nombre relacionada con el CA\n"

