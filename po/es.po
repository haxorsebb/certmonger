#, c-format
msgid "Usage: %s [-s|-S] [-n|-f] [-d LEVEL] [-p FILE] [-F]\n"
msgstr "Utilización: %s [-s|-S] [-n|-f] [-d LEVEL] [-p FILE] [-F]\n"

#: src/main.c:124
msgid "\t-s         use session bus\n"
msgstr "\t-s         usar session bus\n"

#: src/main.c:125
msgid "\t-S         use system bus\n"
msgstr "\t-S         usar system bus\n"

#: src/main.c:126
msgid "\t-n         don't become a daemon\n"
msgstr "\t-n         no se convierta en demonio\n"

#: src/main.c:127
msgid "\t-f         do become a daemon\n"
msgstr "\t-f         conviértase en demonio\n"

