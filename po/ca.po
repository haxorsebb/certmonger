#: src/main.c:137
#, c-format
msgid "Usage: %s [-s|-S] [-n|-f] [-d LEVEL] [-p FILE] [-F]\n"
msgstr "Ús: %s [-s|-S] [-n|-f] [-d NIVELL] [-p FITXER] [-F]\n"

#: src/main.c:141
msgid "\t-s         use session bus\n"
msgstr "\t-s         utilitza el bus de la sessió\n"

#: src/main.c:142
msgid "\t-S         use system bus\n"
msgstr "\t-S         utilitza el bus del sistema\n"

#: src/main.c:143
msgid "\t-l         start a dedicated listening socket\n"
msgstr "\t-l         inicia un socket dedicat a escoltar\n"

#: src/main.c:144
msgid "\t-L         only use a dedicated listening socket\n"
msgstr "\t-L         tan sols utilitza el socket dedicat a escoltar\n"

#: src/main.c:145
msgid "\t-P PATH    specify the dedicated listening socket\n"
msgstr "\t-P CAMÍ    especifica el socket dedicat a escoltar\n"

#: src/main.c:146
msgid "\t-n         don't become a daemon\n"
msgstr "\t-n         no et converteixis en un dimoni\n"

#: src/main.c:147
msgid "\t-f         do become a daemon\n"
msgstr "\t-f         converteix-te en un dimoni\n"

#: src/main.c:148
msgid "\t-b TIMEOUT bus-activated, idle timeout\n"
msgstr "\t-b TIMEOUT activat per bus, temps d'expiració d'inactivitat\n"

#: src/main.c:149
msgid "\t-B         don't use an idle timeout\n"
msgstr "\t-B         no utilitzis un temps d'expiració d'inactivitat\n"

#: src/main.c:150
msgid "\t-d LEVEL   set debugging level (implies -n)\n"
msgstr "\t-d NIVELL   estableix el nivell d depuració (implica -n)\n"

#: src/main.c:151
msgid "\t-c COMMAND start COMMAND and exit when it does\n"
msgstr "\t-c ORDRE inicia l'ORDRE i surt quan també ho faci l'ordre.\n"

#: src/main.c:152
msgid "\t-p FILE    write service PID to file\n"
msgstr "\t-p FITXER    escriu el PID del servei al fitxer\n"

#: src/main.c:153
msgid "\t-F         force NSS into FIPS mode\n"
msgstr "\t-F         força NSS al mode FIPS\n"

