#: src/getcert.c:2374
#, c-format
msgid "Usage: %s request [options]\n"
msgstr "Pemakaian: %s request[options]\n"

#: src/getcert.c:2376 src/getcert.c:2414 src/getcert.c:2452 src/getcert.c:2474
msgid "Required arguments:\n"
msgstr "Argumentasi yang di butuhkan:\n"

#: src/getcert.c:2377 src/getcert.c:2417 src/getcert.c:2455 src/getcert.c:2477
#: src/getcert.c:2521
msgid "* If using an NSS database for storage:\n"
msgstr "*Jika menggunakan database NSS untuk menyimpan:\n"

#: src/getcert.c:2378 src/getcert.c:2418 src/getcert.c:2456 src/getcert.c:2478
msgid "  -d DIR\tNSS database for key and cert\n"
msgstr "-d DIR\tNSS database untuk kunci dan pemastian\n"

#: src/getcert.c:2379 src/getcert.c:2419 src/getcert.c:2457 src/getcert.c:2479
msgid "  -n NAME\tnickname for NSS-based storage (only valid with -d)\n"
msgstr ""
"-n NAME\tnickname untuk dasar penyimpanan NSS (hanya valid dengan -d)\n"

#: src/getcert.c:2380 src/getcert.c:2420 src/getcert.c:2458 src/getcert.c:2480
msgid ""
"  -t NAME\toptional token name for NSS-based storage (only valid with -d)\n"
msgstr ""
"-t NAME\toptional tanda nama untuk dasar penyimpanan NSS (hanya valid dengan "
"-d)\n"

#: src/getcert.c:2381 src/getcert.c:2421 src/getcert.c:2459 src/getcert.c:2481
#: src/getcert.c:2524
msgid "* If using files for storage:\n"
msgstr "*Jika menggunakan berkas untuk penyimpanan:\n"

#: src/getcert.c:2382 src/getcert.c:2422 src/getcert.c:2460
msgid "  -k FILE\tPEM file for private key\n"
msgstr "-k FILE\tPEM berkas untuk kunci privasi\n"

#: src/getcert.c:2383 src/getcert.c:2423 src/getcert.c:2461
msgid "  -f FILE\tPEM file for certificate (only valid with -k)\n"
msgstr "-f FILE\tPEM berkas untuk sertifikat (hanya valid dengan -k)\n"

#: src/getcert.c:2384
msgid "* If keys are to be encrypted:\n"
msgstr ""

#: src/getcert.c:2385 src/getcert.c:2425 src/getcert.c:2485
msgid "  -p FILE\tfile which holds the encryption PIN\n"
msgstr "-p FILE\tfile yang memegang enkripsi suatu PIN\n"

#: src/getcert.c:2386 src/getcert.c:2426 src/getcert.c:2486
msgid "  -P PIN\tPIN value\n"
msgstr ""

#: src/getcert.c:2388 src/getcert.c:2428 src/getcert.c:2463 src/getcert.c:2495
#: src/getcert.c:2512 src/getcert.c:2536
msgid "Optional arguments:\n"
msgstr "Pilihan argumen-argumen:\n"

#: src/getcert.c:2389 src/getcert.c:2429 src/getcert.c:2496
msgid "* Certificate handling settings:\n"
msgstr "* Keadaan menangani sertifikat:\n"

#: src/getcert.c:2390
msgid "  -I NAME\tnickname to assign to the request\n"
msgstr "-I NAME\tnickname untuk menandai sebuah permintaan\n"

#: src/getcert.c:2391
msgid "  -g SIZE\tsize of key to be generated if one is not already in place\n"
msgstr ""
"-g SIZE\tsize  sebuah kunci untuk menghasilkan jika salah satu telah tidak "
"berada di dalam tempat\n"

#: src/getcert.c:2392 src/getcert.c:2431
msgid ""
"  -r\t\tattempt to renew the certificate when expiration nears (default)\n"
msgstr ""
"-r\t\tattempt untuk memperbarui sertifikat ketika mendekati akhir waktu "
"(kegagalan)\n"

#: src/getcert.c:2393 src/getcert.c:2432
msgid "  -R\t\tdon't attempt to renew the certificate when expiration nears\n"
msgstr ""
"-R\t\tdon't usaha untuk memperbarui sertifikat ketika mendekati akhir waktu\n"

#: src/getcert.c:2395 src/getcert.c:2434
msgid "  -c CA\t\tuse the specified CA rather than the default\n"
msgstr " -c CA\t\tuse CA khusus lebih baik daripada kegagalan\n"

#: src/getcert.c:2397
msgid "* Parameters for the signing request:\n"
msgstr "* Beberapa parameter untuk menandai permintaan:\n"

#: src/getcert.c:2398 src/getcert.c:2489
msgid "  -N NAME\tset requested subject name (default: CN=<hostname>)\n"
msgstr "  -N NAME\tset permintaan nama subjek (kegagalan: CN=<hostname>)\n"

#: src/getcert.c:2399 src/getcert.c:2490
msgid "  -U EXTUSAGE\tset requested extended key usage OID\n"
msgstr "-U EXTUSAGE\tset memperluas permintaan pemakaian kunci OID\n"

#: src/getcert.c:2400 src/getcert.c:2491
msgid "  -K NAME\tset requested principal name\n"
msgstr "-K NAME\tset permintaan nama utama\n"

#: src/getcert.c:2401 src/getcert.c:2492
msgid "  -D DNSNAME\tset requested DNS name\n"
msgstr "-D DNSNAME\tset permintaan nama DNS\n"

#: src/getcert.c:2402 src/getcert.c:2493
msgid "  -E EMAIL\tset requested email address\n"
msgstr "-E EMAIL\tset permintaan alamat email\n"

#: src/getcert.c:2403 src/getcert.c:2441 src/getcert.c:2464 src/getcert.c:2501
#: src/getcert.c:2526 src/getcert.c:2541
msgid "* Bus options:\n"
msgstr "* Pilihan Bus:\n"

#: src/getcert.c:2404 src/getcert.c:2442 src/getcert.c:2465 src/getcert.c:2502
msgid "  -S\t\tconnect to the certmonger service on the system bus\n"
msgstr "-S\t\tconnect untuk layanan pemastian dalam sistem bus\n"

#: src/getcert.c:2405 src/getcert.c:2443 src/getcert.c:2466 src/getcert.c:2503
msgid "  -s\t\tconnect to the certmonger service on the session bus\n"
msgstr "-s\t\tconnect untuk layanan pemastian pada pembahasan bus\n"

#: src/getcert.c:2406 src/getcert.c:2444 src/getcert.c:2467 src/getcert.c:2504
#: src/getcert.c:2529 src/getcert.c:2544
msgid "* Other options:\n"
msgstr ""

#: src/getcert.c:2407 src/getcert.c:2445 src/getcert.c:2505
msgid "  -C\tcommand to run when saving the certificate\n"
msgstr ""

#: src/getcert.c:2408 src/getcert.c:2446 src/getcert.c:2468 src/getcert.c:2506
#: src/getcert.c:2530 src/getcert.c:2545
msgid "  -v\treport all details of errors\n"
msgstr ""

