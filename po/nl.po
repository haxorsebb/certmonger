msgid "  -I NAME\tnew nickname to give to tracking request\n"
msgstr "  -I NAAM»nieuwe bijnaam om aan track verzoek te geven\n"

#: src/getcert.c:2712
msgid "  -c CA\t\tuse the specified CA rather than the current one\n"
msgstr "  -c CA»»gebruik de gespecificeerde CA in plaats van de huidige\n"

#: src/getcert.c:2725
#, c-format
msgid "Usage: %s list [options]\n"
msgstr "Gebruik: %s list [opties]\n"

#: src/getcert.c:2728 src/getcert.c:2753
msgid "* General options:\n"
msgstr "* Algemene opties:\n"

#: src/getcert.c:2730
msgid "  -c CA\tlist only requests and certs associated with this CA\n"
msgstr "  -c CA»laat allen verzoeken certificaten zien die bij deze CA horen\n"

#: src/getcert.c:2732
msgid "  -r\tlist only information about outstanding requests\n"
msgstr "  -r»laat alleen informatie zien over uitstaande verzoeken\n"

#: src/getcert.c:2733
msgid "  -t\tlist only information about tracked certificates\n"
msgstr "  -t»laat alleen informatie zien over gevolgde certificaten\n"

#: src/getcert.c:2734
msgid "* If selecting a specific request:\n"
msgstr "* Als een specifiek verzoek geselecteerd wordt:\n"

#: src/getcert.c:2737
msgid "  -d DIR\tonly list requests and certs which use this NSS database\n"
msgstr ""
"  -d MAP»toon alleen verzoeken en certificaten die deze NSS database "
"gebruiken\n"

#: src/getcert.c:2738
msgid "  -n NAME\tonly list requests and certs which use this nickname\n"
msgstr ""
"  -n NAAM» toon alleen verzoeken en certificaten die deze bijnaam gebruiken\n"

#: src/getcert.c:2740
msgid "  -f FILE\tonly list requests and certs stored in this PEM file\n"
msgstr ""
"  -f BESTAND»toon alleen verzoeken en certificaten die in dit PEM bestand "
"opgeslagen zijn\n"

#: src/getcert.c:2742 src/getcert.c:2757
msgid "  -S\tconnect to the certmonger service on the system bus\n"
msgstr "  -S»verbind met de certmonger service op de systeem bus\n"

#: src/getcert.c:2743 src/getcert.c:2758
msgid "  -s\tconnect to the certmonger service on the session bus\n"
msgstr "  -s»verbind met de certmonger service op de sessie bus\n"

#: src/getcert.c:2749
#, c-format
msgid "Usage: %s list-cas [options]\n"
msgstr "Gebruik: %s list-cas [opties]\n"

#: src/getcert.c:2754
msgid "  -c CA\tlist only information about the CA with this name\n"
msgstr "  -c CA»laat alleen informatie zien over de CA met deze naam\n"

