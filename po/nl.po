#: src/getcert.c:2656
#, c-format
msgid "%s - client certificate enrollment tool\n"
msgstr "%s - cliënt certificaat uitgeef gereedschap\n"

#: src/getcert.c:2660
#, c-format
msgid "Usage: %s request [options]\n"
msgstr "Gebruik: %s request [opties]\n"

#: src/getcert.c:2662 src/getcert.c:2705 src/getcert.c:2747 src/getcert.c:2769
msgid "Required arguments:\n"
msgstr "Vereiste argumenten:\n"

#: src/getcert.c:2663 src/getcert.c:2708 src/getcert.c:2750 src/getcert.c:2772
#: src/getcert.c:2820
msgid "* If using an NSS database for storage:\n"
msgstr "* Als een NSS database voor opslag gebruikt wordt:\n"

#: src/getcert.c:2664 src/getcert.c:2709 src/getcert.c:2751 src/getcert.c:2773
msgid "  -d DIR\tNSS database for key and cert\n"
msgstr "  -d MAP»NSS database voor sleutel en cert\n"

#: src/getcert.c:2665 src/getcert.c:2710 src/getcert.c:2752 src/getcert.c:2774
msgid "  -n NAME\tnickname for NSS-based storage (only valid with -d)\n"
msgstr "  -n NAAM»bijnaam voor op NSS gebaseerde opslag (alleen geldig met -d)\n"

#: src/getcert.c:2666 src/getcert.c:2711 src/getcert.c:2753 src/getcert.c:2775
msgid ""
"  -t NAME\toptional token name for NSS-based storage (only valid with -d)\n"
msgstr "  -t NAAM»optionele token naam voor op NSS gebaseerde opslag (alleen geldig met -d)\n"

#: src/getcert.c:2667 src/getcert.c:2712 src/getcert.c:2754 src/getcert.c:2776
#: src/getcert.c:2823
msgid "* If using files for storage:\n"
msgstr "* Als bestanden voor opslag gebruikt worden:\n"

#: src/getcert.c:2668 src/getcert.c:2713 src/getcert.c:2755
msgid "  -k FILE\tPEM file for private key\n"
msgstr "  -k BESTAND»PEM bestand voor prive sleutel\n"

#: src/getcert.c:2669 src/getcert.c:2714 src/getcert.c:2756
msgid "  -f FILE\tPEM file for certificate (only valid with -k)\n"
msgstr "  -f BESTAND»PEM bestand voor certificaat (alleen geldig met -k)\n"

#: src/getcert.c:2670
msgid "* If keys are to be encrypted:\n"
msgstr "* Als sleutels gecodeerd moeten worden:\n"

#: src/getcert.c:2671 src/getcert.c:2716 src/getcert.c:2780
msgid "  -p FILE\tfile which holds the encryption PIN\n"
msgstr "  -p BESTAND»bestand welke de codering PIN bevat\n"

#: src/getcert.c:2672 src/getcert.c:2717 src/getcert.c:2781
msgid "  -P PIN\tPIN value\n"
msgstr "  -P PIN»PIN waarde\n"

#: src/getcert.c:2674 src/getcert.c:2719 src/getcert.c:2758 src/getcert.c:2792
#: src/getcert.c:2811 src/getcert.c:2835
msgid "Optional arguments:\n"
msgstr "Optionele argumenten:\n"

#: src/getcert.c:2675 src/getcert.c:2720 src/getcert.c:2793
msgid "* Certificate handling settings:\n"
msgstr "* Certificaat afhandel instellingen:\n"

#: src/getcert.c:2676
msgid "  -I NAME\tnickname to assign to the request\n"
msgstr "  -I NAAM»bijnaam toegekend aan het verzoek\n"

#: src/getcert.c:2677
msgid "  -G TYPE\ttype of key to be generated if one is not already in place\n"
msgstr "  -G TYPE\tsleuteltype dat aangemaakt wordt als er nog geen aanwezig is\n"

#: src/getcert.c:2678
msgid "  -g SIZE\tsize of key to be generated if one is not already in place\n"
msgstr "  -g GROOTTE»grootte van de te genereren sleutel als er nog geen aanwezig is\n"

#: src/getcert.c:2679 src/getcert.c:2722
msgid "  -r\t\tattempt to renew the certificate when expiration nears (default)\n"
msgstr "  -r»»probeer het certificaat te vernieuwen als de verloopdatum nadert (standaard)\n"

#: src/getcert.c:2680 src/getcert.c:2723
msgid "  -R\t\tdon't attempt to renew the certificate when expiration nears\n"
msgstr "  -R»»probeer het certificaat niet te vernieuwen als de verloopdatum nadert\n"

#: src/getcert.c:2682 src/getcert.c:2725
msgid "  -c CA\t\tuse the specified CA rather than the default\n"
msgstr "  -c CA»»gebruik de gespecificeerde CA in plaats van de standaard\n"

#: src/getcert.c:2684 src/getcert.c:2727 src/getcert.c:2798
msgid ""
"  -T PROFILE\task the CA to process the request using the named profile or "
"template\n"
msgstr "  -T PROFILE\tvraag de CA om het verzoek de verwerken met het opgegeven profiel of template\n"

#: src/getcert.c:2685
msgid "* Parameters for the signing request:\n"
msgstr "* Parameters voor het ondertekening verzoek:\n"

#: src/getcert.c:2686 src/getcert.c:2784
msgid "  -N NAME\tset requested subject name (default: CN=<hostname>)\n"
msgstr "  -N NAAM»stel de gevraagde subject naam in (standaard: CN=<hostnaam>)\n"

#: src/getcert.c:2687 src/getcert.c:2785
msgid "  -U EXTUSAGE\tset requested extended key usage OID\n"
msgstr "  -U EXTUSAGE»stel het gevraagde uitgebreide sleutel gebruik OID in\n"

#: src/getcert.c:2688 src/getcert.c:2730 src/getcert.c:2786
msgid "  -u KEYUSAGE\tset requested key usage value\n"
msgstr "  -u KEYUSAGE\tstel aangevraagde sleutel gebruik waarde in\n"

#: src/getcert.c:2689 src/getcert.c:2787
msgid "  -K NAME\tset requested principal name\n"
msgstr "  -K NAAM»stel de gevraagde principal naam in\n"

#: src/getcert.c:2690 src/getcert.c:2788
msgid "  -D DNSNAME\tset requested DNS name\n"
msgstr "  -D DNSNAAM»stel de gevraagde DNS naam in\n"

#: src/getcert.c:2691 src/getcert.c:2789
msgid "  -E EMAIL\tset requested email address\n"
msgstr "  -E EMAIL»stel het gevraagde email adres in\n"

#: src/getcert.c:2692 src/getcert.c:2790
msgid "  -A ADDRESS\tset requested IP address\n"
msgstr "  -A ADRES\tstel vereiste IP adres in\n"

#: src/getcert.c:2693 src/getcert.c:2735 src/getcert.c:2759 src/getcert.c:2799
#: src/getcert.c:2825 src/getcert.c:2840
msgid "* Bus options:\n"
msgstr "* Bus opties:\n"

#: src/getcert.c:2694 src/getcert.c:2736 src/getcert.c:2760 src/getcert.c:2800
msgid "  -S\t\tconnect to the certmonger service on the system bus\n"
msgstr "  -S»»verbind met de certmonger service op de systeem bus\n"

#: src/getcert.c:2695 src/getcert.c:2737 src/getcert.c:2761 src/getcert.c:2801
msgid "  -s\t\tconnect to the certmonger service on the session bus\n"
msgstr "  -s»»verbind met de certmonger service op de sessie bus\n"

