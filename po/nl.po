#: src/getcert.c:2374
#, c-format
msgid "Usage: %s request [options]\n"
msgstr "Gebruik: %s request [opties]\n"

#: src/getcert.c:2376 src/getcert.c:2414 src/getcert.c:2452 src/getcert.c:2474
msgid "Required arguments:\n"
msgstr "Vereiste argumenten:\n"

#: src/getcert.c:2377 src/getcert.c:2417 src/getcert.c:2455 src/getcert.c:2477
#: src/getcert.c:2521
msgid "* If using an NSS database for storage:\n"
msgstr "* Als een NSS database voor opslag gebruikt wordt:\n"

#: src/getcert.c:2378 src/getcert.c:2418 src/getcert.c:2456 src/getcert.c:2478
msgid "  -d DIR\tNSS database for key and cert\n"
msgstr "  -d MAP»NSS database voor sleutel en cert\n"

#: src/getcert.c:2379 src/getcert.c:2419 src/getcert.c:2457 src/getcert.c:2479
msgid "  -n NAME\tnickname for NSS-based storage (only valid with -d)\n"
msgstr ""
"  -n NAAM»bijnaam voor op NSS gebaseerde opslag (alleen geldig met -d)\n"

#: src/getcert.c:2380 src/getcert.c:2420 src/getcert.c:2458 src/getcert.c:2480
msgid ""
"  -t NAME\toptional token name for NSS-based storage (only valid with -d)\n"
msgstr ""
"  -t NAAM»optionele token naam voor op NSS gebaseerde opslag (alleen geldig "
"met -d)\n"

#: src/getcert.c:2381 src/getcert.c:2421 src/getcert.c:2459 src/getcert.c:2481
#: src/getcert.c:2524
msgid "* If using files for storage:\n"
msgstr "* Als bestanden voor opslag gebruikt worden:\n"

#: src/getcert.c:2382 src/getcert.c:2422 src/getcert.c:2460
msgid "  -k FILE\tPEM file for private key\n"
msgstr "  -k BESTAND»PEM bestand voor prive sleutel\n"

#: src/getcert.c:2383 src/getcert.c:2423 src/getcert.c:2461
msgid "  -f FILE\tPEM file for certificate (only valid with -k)\n"
msgstr "  -f BESTAND»PEM bestand voor certificaat (alleen geldig met -k)\n"

#: src/getcert.c:2384
msgid "* If keys are to be encrypted:\n"
msgstr "* Als sleutels gecodeerd moeten worden:\n"

#: src/getcert.c:2385 src/getcert.c:2425 src/getcert.c:2485
msgid "  -p FILE\tfile which holds the encryption PIN\n"
msgstr "  -p BESTAND»bestand welke de codering PIN bevat\n"

#: src/getcert.c:2386 src/getcert.c:2426 src/getcert.c:2486
msgid "  -P PIN\tPIN value\n"
msgstr "  -P PIN»PIN waarde\n"

#: src/getcert.c:2388 src/getcert.c:2428 src/getcert.c:2463 src/getcert.c:2495
#: src/getcert.c:2512 src/getcert.c:2536
msgid "Optional arguments:\n"
msgstr "Optionele argumenten:\n"

#: src/getcert.c:2389 src/getcert.c:2429 src/getcert.c:2496
msgid "* Certificate handling settings:\n"
msgstr "* Certificaat afhandel instellingen:\n"

#: src/getcert.c:2390
msgid "  -I NAME\tnickname to assign to the request\n"
msgstr "  -I NAAM»bijnaam toegekend aan het verzoek\n"

#: src/getcert.c:2391
msgid "  -g SIZE\tsize of key to be generated if one is not already in place\n"
msgstr ""
"  -g GROOTTE»grootte van de te genereren sleutel als er nog geen aanwezig "
"is\n"

#: src/getcert.c:2392 src/getcert.c:2431
msgid ""
"  -r\t\tattempt to renew the certificate when expiration nears (default)\n"
msgstr ""
"  -r»»probeer het certificaat te vernieuwen als de verloopdatum nadert "
"(standaard)\n"

#: src/getcert.c:2393 src/getcert.c:2432
msgid "  -R\t\tdon't attempt to renew the certificate when expiration nears\n"
msgstr ""
"  -R»»probeer het certificaat niet te vernieuwen als de verloopdatum nadert\n"

#: src/getcert.c:2395 src/getcert.c:2434
msgid "  -c CA\t\tuse the specified CA rather than the default\n"
msgstr "  -c CA»»gebruik de gespecificeerde CA in plaats van de standaard\n"

#: src/getcert.c:2397
msgid "* Parameters for the signing request:\n"
msgstr "* Parameters voor het ondertekening verzoek:\n"

#: src/getcert.c:2398 src/getcert.c:2489
msgid "  -N NAME\tset requested subject name (default: CN=<hostname>)\n"
msgstr ""
"  -N NAAM»stel de gevraagde subject naam in (standaard: CN=<hostnaam>)\n"

#: src/getcert.c:2399 src/getcert.c:2490
msgid "  -U EXTUSAGE\tset requested extended key usage OID\n"
msgstr "  -U EXTUSAGE»stel het gevraagde uitgebreide sleutel gebruik OID in\n"

#: src/getcert.c:2400 src/getcert.c:2491
msgid "  -K NAME\tset requested principal name\n"
msgstr "  -K NAAM»stel de gevraagde principal naam in\n"

#: src/getcert.c:2401 src/getcert.c:2492
msgid "  -D DNSNAME\tset requested DNS name\n"
msgstr "  -D DNSNAAM»stel de gevraagde DNS naam in\n"

#: src/getcert.c:2402 src/getcert.c:2493
msgid "  -E EMAIL\tset requested email address\n"
msgstr "  -E EMAIL»stel het gevraagde email adres in\n"

#: src/getcert.c:2403 src/getcert.c:2441 src/getcert.c:2464 src/getcert.c:2501
#: src/getcert.c:2526 src/getcert.c:2541
msgid "* Bus options:\n"
msgstr "* Bus opties:\n"

#: src/getcert.c:2404 src/getcert.c:2442 src/getcert.c:2465 src/getcert.c:2502
msgid "  -S\t\tconnect to the certmonger service on the system bus\n"
msgstr "  -S»»verbind met de certmonger service op de systeem bus\n"

#: src/getcert.c:2405 src/getcert.c:2443 src/getcert.c:2466 src/getcert.c:2503
msgid "  -s\t\tconnect to the certmonger service on the session bus\n"
msgstr "  -s»»verbind met de certmonger service op de sessie bus\n"

#: src/getcert.c:2406 src/getcert.c:2444 src/getcert.c:2467 src/getcert.c:2504
#: src/getcert.c:2529 src/getcert.c:2544
msgid "* Other options:\n"
msgstr "* Andere opties:\n"

#: src/getcert.c:2407 src/getcert.c:2445 src/getcert.c:2505
msgid "  -C\tcommand to run when saving the certificate\n"
msgstr ""

#: src/getcert.c:2408 src/getcert.c:2446 src/getcert.c:2468 src/getcert.c:2506
#: src/getcert.c:2530 src/getcert.c:2545
msgid "  -v\treport all details of errors\n"
msgstr "  -v»rapporteer alle foutdetails\n"

#: src/getcert.c:2412
#, c-format
msgid "Usage: %s start-tracking [options]\n"
msgstr "Gebruik: %s start-tracking [opties]\n"

#: src/getcert.c:2415
msgid "* If modifying an existing request:\n"
msgstr "* Als een bestaande aanvraag veranderd wordt:\n"

#: src/getcert.c:2416
msgid "  -i NAME\tnickname of an existing tracking request\n"
msgstr "  -i NAAM»bijnaam van een bestaand track verzoek\n"

#: src/getcert.c:2424 src/getcert.c:2484
msgid "* If keys are encrypted:\n"
msgstr "* Als sleutels gecodeerd zijn:\n"

#: src/getcert.c:2430
msgid "  -I NAME\tnickname to give to tracking request\n"
msgstr "  -I NAAM»bijnaam te geven aan track verzoek\n"

#: src/getcert.c:2436
msgid "* Parameters for the signing request at renewal time:\n"
msgstr "* Parameters voor het ondertekeningverzoek bij het vernieuwen:\n"

#: src/getcert.c:2437
msgid "  -U EXTUSAGE\toverride requested extended key usage OID\n"
msgstr "  -U EXTUSAGE»overschrijf gevraagde uitgebreide sleutel gebruik OID\n"

#: src/getcert.c:2438
msgid "  -K NAME\toverride requested principal name\n"
msgstr "  -K NAAM»overschrijf gevraagde principal naame\n"

#: src/getcert.c:2439
msgid "  -D DNSNAME\toverride requested DNS name\n"
msgstr "  -D DNSNAAM»overschrijf gevraagde DNS naam\n"

#: src/getcert.c:2440
msgid "  -E EMAIL\toverride requested email address\n"
msgstr "  -E EMAIL»overschrijf gevraagde email adres\n"

#: src/getcert.c:2450
#, c-format
msgid "Usage: %s stop-tracking [options]\n"
msgstr "Gebruik: %s stop-tracking [opties]\n"

#: src/getcert.c:2453 src/getcert.c:2475
msgid "* By request identifier:\n"
msgstr "* Op verzoek id:\n"

#: src/getcert.c:2454 src/getcert.c:2476 src/getcert.c:2520
msgid "  -i NAME\tnickname for tracking request\n"
msgstr "  -i NAAM»bijnaam voor track verzoek\n"

#: src/getcert.c:2472
#, c-format
msgid "Usage: %s resubmit [options]\n"
msgstr "Gebruik: %s resubmit [opties]\n"

#: src/getcert.c:2482
msgid "  -f FILE\tPEM file for certificate\n"
msgstr "  -f BESTAND»PEM bestand voor certificaat\n"

#: src/getcert.c:2488
msgid "* New parameter values for the signing request:\n"
msgstr "* Nieuwe parameterwaarden voor de ondertekening verzoek:\n"

#: src/getcert.c:2497
msgid "  -I NAME\tnew nickname to give to tracking request\n"
msgstr "  -I NAAM»nieuwe bijnaam om aan track verzoek te geven\n"

#: src/getcert.c:2499
