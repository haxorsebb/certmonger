#: src/getcert.c:2585 src/getcert.c:2628 src/getcert.c:2669 src/getcert.c:2691
msgid "  -n NAME\tnickname for NSS-based storage (only valid with -d)\n"
msgstr "  -n NAME\tKurzname für NSS-basierte Speicherung (nur gültig mit -d)\n"

